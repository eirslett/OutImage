    boolean procedure realdiff (x, y); long real x, y;
//  ^^^^^^^ storage.type
//          ^^^^^^^^^ storage.type
//                    ^^^^^^^^ entity.name.function
//                             ^ punctuation.section.parens
//                              ^ variable.parameter
//                               ^ punctuation.separator
//                                 ^ variable.parameter
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                     ^^^^ storage.type
//                                          ^^^^ storage.type
//                                               ^ variable
//                                                ^ punctuation.separator
//                                                  ^ variable
//                                                   ^ punctuation.terminator.statement
    begin
//  ^^^^^ keyword.control.begin
       long real diff; integer pow;
//     ^^^^ storage.type
//          ^^^^ storage.type
//               ^^^^ variable
//                   ^ punctuation.terminator.statement
//                     ^^^^^^^ storage.type
//                             ^^^ variable
//                                ^ punctuation.terminator.statement
%      if x > maxlongdig then begin 
// <------------------------------------ comment.directive
%         while x > 10 do begin x:=x/(10&&16); pow:=pow+16 end;
// <--------------------------------------------------------------- comment.directive
%         x:=x*(10&&0**pow);
// <---------------------------- comment.directive
%      end;
// <----------- comment.directive
%      if y > maxlongdig then begin
// <----------------------------------- comment.directive
%         while y > 10 do begin y:=y/(10&&16); pow:=pow+16 end;
// <--------------------------------------------------------------- comment.directive
%         y:=y*(10&&0**pow);
// <---------------------------- comment.directive
%      end;
// <----------- comment.directive

       diff:= abs (if x=0 then x-y else (x-y) / x);
//     ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^ keyword.control.if
//                    ^ variable
//                     ^ keyword.operator.comparison
//                      ^ constant.numeric.decimal
//                        ^^^^ keyword.control.then
//                             ^ variable
//                              ^ keyword.operator.arithmetic
//                               ^ variable
//                                 ^^^^ keyword.control.else
//                                      ^ punctuation.section.parens
//                                       ^ variable
//                                        ^ keyword.operator.arithmetic
//                                         ^ variable
//                                          ^ punctuation.section.parens
//                                            ^ keyword.operator.arithmetic
//                                              ^ variable
//                                               ^ punctuation.section.parens
//                                                ^ punctuation.terminator.statement

       if diff > 7.0&-14 then                             !***** NOTE 1 *****;
//     ^^ keyword.control.if
//        ^^^^ variable
//             ^ keyword.operator.comparison
//               ^^^^^^^ constant.numeric.decimal
//                       ^^^^ keyword.control.then
//                                                        ^^^^^^^^^^^^^^^^^^^^ comment.block
       begin
//     ^^^^^ keyword.control.begin
          outtext ("*** rel. error= ");
//        ^^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                   ^ punctuation.section.parens
//                                    ^ punctuation.terminator.statement
          outreal (diff, 16, 23);
//        ^^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^^^ variable
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
          outimage;
//        ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
          realdiff:=  true;
//        ^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                    ^^^^ constant.language.bool
//                        ^ punctuation.terminator.statement
       end
//     ^^^ keyword.control.end
    end of procedure realdiff;
//  ^^^ keyword.control.end
//      ^^^^^^^^^^^^^^^^^^^^^ comment.block
//                           ^ punctuation.terminator.statement


    long real procedure rpower (x, y); long real x, y;
//  ^^^^ storage.type
//       ^^^^ storage.type
//            ^^^^^^^^^ storage.type
//                      ^^^^^^ entity.name.function
//                             ^ punctuation.section.parens
//                              ^ variable.parameter
//                               ^ punctuation.separator
//                                 ^ variable.parameter
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                     ^^^^ storage.type
//                                          ^^^^ storage.type
//                                               ^ variable
//                                                ^ punctuation.separator
//                                                  ^ variable
//                                                   ^ punctuation.terminator.statement
       rpower:= exp (y * ln (x) );
//     ^^^^^^ variable
//           ^^ keyword.operator.assignment
//              ^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                     ^ keyword.operator.arithmetic
//                       ^^ entity.name.function
//                          ^ punctuation.section.parens
//                           ^ variable
//                            ^ punctuation.section.parens
//                              ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement


    long real procedure ipower (b, j); long real b; integer j;
//  ^^^^ storage.type
//       ^^^^ storage.type
//            ^^^^^^^^^ storage.type
//                      ^^^^^^ entity.name.function
//                             ^ punctuation.section.parens
//                              ^ variable.parameter
//                               ^ punctuation.separator
//                                 ^ variable.parameter
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                     ^^^^ storage.type
//                                          ^^^^ storage.type
//                                               ^ variable
//                                                ^ punctuation.terminator.statement
//                                                  ^^^^^^^ storage.type
//                                                          ^ variable
//                                                           ^ punctuation.terminator.statement
    begin
//  ^^^^^ keyword.control.begin
       integer exp; long real prod, base;
//     ^^^^^^^ storage.type
//             ^^^ variable
//                ^ punctuation.terminator.statement
//                  ^^^^ storage.type
//                       ^^^^ storage.type
//                            ^^^^ variable
//                                ^ punctuation.separator
//                                  ^^^^ variable
//                                      ^ punctuation.terminator.statement

       boolean procedure bit0 (n); integer n;
//     ^^^^^^^ storage.type
//             ^^^^^^^^^ storage.type
//                       ^^^^ entity.name.function
//                            ^ punctuation.section.parens
//                             ^ variable.parameter
//                              ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
//                                 ^^^^^^^ storage.type
//                                         ^ variable
//                                          ^ punctuation.terminator.statement
          bit0:= (n//2) * 2<n;
//        ^^^^ variable
//            ^^ keyword.operator.assignment
//               ^ punctuation.section.parens
//                ^ variable
//                 ^^ keyword.operator.arithmetic
//                   ^ constant.numeric.decimal
//                    ^ punctuation.section.parens
//                      ^ keyword.operator.arithmetic
//                        ^ constant.numeric.decimal
//                         ^ keyword.operator.comparison
//                          ^ variable
//                           ^ punctuation.terminator.statement

       base:= b; exp:= abs (j);
//     ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//             ^ punctuation.terminator.statement
//               ^^^ variable
//                  ^^ keyword.operator.assignment
//                     ^^^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.section.parens
//                            ^ punctuation.terminator.statement
       prod:= if bit0 (exp) then base else 1.0;
//     ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^^ keyword.control.if
//               ^^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^^^ variable
//                        ^ punctuation.section.parens
//                          ^^^^ keyword.control.then
//                               ^^^^ variable
//                                    ^^^^ keyword.control.else
//                                         ^^^ constant.numeric.decimal
//                                            ^ punctuation.terminator.statement

       while exp > 1 do
//     ^^^^^ keyword.control.while
//           ^^^ variable
//               ^ keyword.operator.comparison
//                 ^ constant.numeric.decimal
//                   ^^ keyword.control.do
       begin
//     ^^^^^ keyword.control.begin
          base:= base * base; exp:= exp//2;
//        ^^^^ variable
//            ^^ keyword.operator.assignment
//               ^^^^ variable
//                    ^ keyword.operator.arithmetic
//                      ^^^^ variable
//                          ^ punctuation.terminator.statement
//                            ^^^ variable
//                               ^^ keyword.operator.assignment
//                                  ^^^ variable
//                                     ^^ keyword.operator.arithmetic
//                                       ^ constant.numeric.decimal
//                                        ^ punctuation.terminator.statement
          if bit0 (exp) then prod:= prod * base;
//        ^^ keyword.control.if
//           ^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^^ variable
//                    ^ punctuation.section.parens
//                      ^^^^ keyword.control.then
//                           ^^^^ variable
//                               ^^ keyword.operator.assignment
//                                  ^^^^ variable
//                                       ^ keyword.operator.arithmetic
//                                         ^^^^ variable
//                                             ^ punctuation.terminator.statement
       end;
//     ^^^ keyword.control.end
//        ^ punctuation.terminator.statement

       ipower:= if j>0 then prod else 1.0 / prod;
//     ^^^^^^ variable
//           ^^ keyword.operator.assignment
//              ^^ keyword.control.if
//                 ^ variable
//                  ^ keyword.operator.comparison
//                   ^ constant.numeric.decimal
//                     ^^^^ keyword.control.then
//                          ^^^^ variable
//                               ^^^^ keyword.control.else
//                                    ^^^ constant.numeric.decimal
//                                        ^ keyword.operator.arithmetic
//                                          ^^^^ variable
//                                              ^ punctuation.terminator.statement

    end of procedure ipower;
//  ^^^ keyword.control.end
//      ^^^^^^^^^^^^^^^^^^^ comment.block
//                         ^ punctuation.terminator.statement


    procedure testrpower (b, e); long real b, e;
//  ^^^^^^^^^ storage.type
//            ^^^^^^^^^^ entity.name.function
//                       ^ punctuation.section.parens
//                        ^ variable.parameter
//                         ^ punctuation.separator
//                           ^ variable.parameter
//                            ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                               ^^^^ storage.type
//                                    ^^^^ storage.type
//                                         ^ variable
//                                          ^ punctuation.separator
//                                            ^ variable
//                                             ^ punctuation.terminator.statement
    begin
//  ^^^^^ keyword.control.begin
       long real x, y;
//     ^^^^ storage.type
//          ^^^^ storage.type
//               ^ variable
//                ^ punctuation.separator
//                  ^ variable
//                   ^ punctuation.terminator.statement

       if b>0.0 then
//     ^^ keyword.control.if
//        ^ variable
//         ^ keyword.operator.comparison
//          ^^^ constant.numeric.decimal
//              ^^^^ keyword.control.then
       begin
//     ^^^^^ keyword.control.begin
          x:= rpower (b, e); y:= b**e;
//        ^ variable
//         ^^ keyword.operator.assignment
//            ^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.separator
//                       ^ variable
//                        ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
//                           ^ variable
//                            ^^ keyword.operator.assignment
//                               ^ variable
//                                ^^ keyword.operator.arithmetic
//                                  ^ variable
//                                   ^ punctuation.terminator.statement

          if realdiff (x, y) then
//        ^^ keyword.control.if
//           ^^^^^^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable
//                      ^ punctuation.separator
//                        ^ variable
//                         ^ punctuation.section.parens
//                           ^^^^ keyword.control.then
          begin
//        ^^^^^ keyword.control.begin
             error ("rpower");
//           ^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^^^^^^^^ string.quoted.double
//                          ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
             outtext ("  base=");
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^ string.quoted.double
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
             outreal (b, 16, 23);
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
             outtext ("          exp=");
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^^^^^^^^ string.quoted.double
//                                    ^ punctuation.section.parens
//                                     ^ punctuation.terminator.statement
             outreal (e, 16, 23);
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
             outimage;
//           ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement
             outtext ("  exp(y*ln(x))= ");
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                      ^ punctuation.section.parens
//                                       ^ punctuation.terminator.statement
             outreal (x, 16, 23);
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
             outimage;
//           ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement
             outtext ("  base**exp=    ");
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                      ^ punctuation.section.parens
//                                       ^ punctuation.terminator.statement
             outreal (y, 16, 23);
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
             outimage; outimage
//           ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement
//                     ^^^^^^^^ variable
          end if
//        ^^^ keyword.control.end
//            ^^ comment.block
       end
//     ^^^ keyword.control.end
    end of procedure testrpower;
//  ^^^ keyword.control.end
//      ^^^^^^^^^^^^^^^^^^^^^^^ comment.block
//                             ^ punctuation.terminator.statement


    procedure testipower (b, e); integer b, e;
//  ^^^^^^^^^ storage.type
//            ^^^^^^^^^^ entity.name.function
//                       ^ punctuation.section.parens
//                        ^ variable.parameter
//                         ^ punctuation.separator
//                           ^ variable.parameter
//                            ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                               ^^^^^^^ storage.type
//                                       ^ variable
//                                        ^ punctuation.separator
//                                          ^ variable
//                                           ^ punctuation.terminator.statement
    begin
//  ^^^^^ keyword.control.begin
       long real x, y, z, r;
//     ^^^^ storage.type
//          ^^^^ storage.type
//               ^ variable
//                ^ punctuation.separator
//                  ^ variable
//                   ^ punctuation.separator
//                     ^ variable
//                      ^ punctuation.separator
//                        ^ variable
//                         ^ punctuation.terminator.statement
       Boolean n;
//     ^^^^^^^ storage.type
//             ^ variable
//              ^ punctuation.terminator.statement

       r:= b;
//     ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//          ^ punctuation.terminator.statement
       if b<>0 and e<>0 then
//     ^^ keyword.control.if
//        ^ variable
//         ^^ keyword.operator.comparison
//           ^ constant.numeric.decimal
//             ^^^ keyword.operator
//                 ^ variable
//                  ^^ keyword.operator.comparison
//                    ^ constant.numeric.decimal
//                      ^^^^ keyword.control.then
       begin
//     ^^^^^ keyword.control.begin
          if e<0 then begin n:= true; e:= -e end;
//        ^^ keyword.control.if
//           ^ variable
//            ^ keyword.operator.comparison
//             ^ constant.numeric.decimal
//               ^^^^ keyword.control.then
//                    ^^^^^ keyword.control.begin
//                          ^ variable
//                           ^^ keyword.operator.assignment
//                              ^^^^ constant.language.bool
//                                  ^ punctuation.terminator.statement
//                                    ^ variable
//                                     ^^ keyword.operator.assignment
//                                        ^ keyword.operator.arithmetic
//                                         ^ variable
//                                           ^^^ keyword.control.end
//                                              ^ punctuation.terminator.statement

          x:= ipower (b, e); y:= b**e; z:= r**e;
//        ^ variable
//         ^^ keyword.operator.assignment
//            ^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.separator
//                       ^ variable
//                        ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
//                           ^ variable
//                            ^^ keyword.operator.assignment
//                               ^ variable
//                                ^^ keyword.operator.arithmetic
//                                  ^ variable
//                                   ^ punctuation.terminator.statement
//                                     ^ variable
//                                      ^^ keyword.operator.assignment
//                                         ^ variable
//                                          ^^ keyword.operator.arithmetic
//                                            ^ variable
//                                             ^ punctuation.terminator.statement

          if realdiff (x, y) or realdiff (y, z) then
//        ^^ keyword.control.if
//           ^^^^^^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable
//                      ^ punctuation.separator
//                        ^ variable
//                         ^ punctuation.section.parens
//                           ^^ keyword.operator
//                              ^^^^^^^^ entity.name.function
//                                       ^ punctuation.section.parens
//                                        ^ variable
//                                         ^ punctuation.separator
//                                           ^ variable
//                                            ^ punctuation.section.parens
//                                              ^^^^ keyword.control.then
          begin
//        ^^^^^ keyword.control.begin
             if n then e:= -e;
//           ^^ keyword.control.if
//              ^ variable
//                ^^^^ keyword.control.then
//                     ^ variable
//                      ^^ keyword.operator.assignment
//                         ^ keyword.operator.arithmetic
//                          ^ variable
//                           ^ punctuation.terminator.statement
             error ("ipower");
//           ^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^^^^^^^^ string.quoted.double
//                          ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
             outtext ("  base=");
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^ string.quoted.double
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
             outint (b, 12);
//           ^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                    ^ punctuation.separator
//                      ^^ constant.numeric.decimal
//                        ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
             outtext ("                     exp=");
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                ^ punctuation.terminator.statement
             outint (e, 12);
//           ^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                    ^ punctuation.separator
//                      ^^ constant.numeric.decimal
//                        ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
             outimage;
//           ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement
             outtext ("  base**abs(exp) ="); outimage;
//           ^^^^^^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
//                                           ^^^^^^^^ variable
//                                                   ^ punctuation.terminator.statement
             outtext("  ipower: "); outreal (x, 16, 23); outimage;
//           ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^^^^^^^^ string.quoted.double
//                               ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
//                                  ^^^^^^^ entity.name.function
//                                          ^ punctuation.section.parens
//                                           ^ variable
//                                            ^ punctuation.separator
//                                              ^^ constant.numeric.decimal
//                                                ^ punctuation.separator
//                                                  ^^ constant.numeric.decimal
//                                                    ^ punctuation.section.parens
//                                                     ^ punctuation.terminator.statement
//                                                       ^^^^^^^^ variable
//                                                               ^ punctuation.terminator.statement
             outtext("  i**i:   "); outreal (y, 16, 23); outimage;
//           ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^^^^^^^^ string.quoted.double
//                               ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
//                                  ^^^^^^^ entity.name.function
//                                          ^ punctuation.section.parens
//                                           ^ variable
//                                            ^ punctuation.separator
//                                              ^^ constant.numeric.decimal
//                                                ^ punctuation.separator
//                                                  ^^ constant.numeric.decimal
//                                                    ^ punctuation.section.parens
//                                                     ^ punctuation.terminator.statement
//                                                       ^^^^^^^^ variable
//                                                               ^ punctuation.terminator.statement
             outtext("  r**i:   "); outreal (z, 16, 23); outimage;
//           ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^^^^^^^^ string.quoted.double
//                               ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
//                                  ^^^^^^^ entity.name.function
//                                          ^ punctuation.section.parens
//                                           ^ variable
//                                            ^ punctuation.separator
//                                              ^^ constant.numeric.decimal
//                                                ^ punctuation.separator
//                                                  ^^ constant.numeric.decimal
//                                                    ^ punctuation.section.parens
//                                                     ^ punctuation.terminator.statement
//                                                       ^^^^^^^^ variable
//                                                               ^ punctuation.terminator.statement
             outimage
//           ^^^^^^^^ variable
          end error
//        ^^^ keyword.control.end
//            ^^^^^ comment.block
       end
//     ^^^ keyword.control.end
    end of procedure testipower;
//  ^^^ keyword.control.end
//      ^^^^^^^^^^^^^^^^^^^^^^^ comment.block
//                             ^ punctuation.terminator.statement


    procedure testsqrt (x); long real x;
//  ^^^^^^^^^ storage.type
//            ^^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ variable.parameter
//                       ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
//                          ^^^^ storage.type
//                               ^^^^ storage.type
//                                    ^ variable
//                                     ^ punctuation.terminator.statement
    begin
//  ^^^^^ keyword.control.begin
       long real a;
//     ^^^^ storage.type
//          ^^^^ storage.type
//               ^ variable
//                ^ punctuation.terminator.statement

       a:= sqrt (x)**2;
//     ^ variable
//      ^^ keyword.operator.assignment
//         ^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable
//                ^ punctuation.section.parens
//                 ^^ keyword.operator.arithmetic
//                   ^ constant.numeric.decimal
//                    ^ punctuation.terminator.statement

       if realdiff (a, x) then
//     ^^ keyword.control.if
//        ^^^^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^ variable
//                   ^ punctuation.separator
//                     ^ variable
//                      ^ punctuation.section.parens
//                        ^^^^ keyword.control.then
       begin
//     ^^^^^ keyword.control.begin
          error ("sqrt");
//        ^^^^^ entity.name.function
//              ^ punctuation.section.parens

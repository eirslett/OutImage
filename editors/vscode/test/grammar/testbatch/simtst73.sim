// SYNTAX TEST "source.simula" "simtst73"
% ===============================================   Main   program =============
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 73
// <-------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     Test of formal procedures.
// <------------------------------------------ comment.directive
%
// <- comment.directive
%  WRITTEN BY:  BEH   25/08-86
// <------------------------------ comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   Procedure P(Q); Procedure Q;
// ^^^^^^^^^ storage.type
//           ^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable.parameter
//              ^ punctuation.section.parens
//               ^ punctuation.terminator.statement
//                 ^^^^^^^^^ storage.type
//                           ^ entity.name.function
//                            ^ punctuation.terminator.statement
        Q(i);
//      ^ entity.name.function
//       ^ punctuation.section.parens
//        ^ variable
//         ^ punctuation.section.parens
//          ^ punctuation.terminator.statement

   Integer i;
// ^^^^^^^ storage.type
//         ^ variable
//          ^ punctuation.terminator.statement

   Class A;
// ^^^^^ keyword.other.class
//       ^ entity.name.class
//        ^ punctuation.terminator.statement
   Begin Procedure R(k); Name k; Integer k;
// ^^^^^ keyword.control.begin
//       ^^^^^^^^^ storage.type
//                 ^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable.parameter
//                    ^ punctuation.section.parens
//                     ^ punctuation.terminator.statement
//                       ^^^^ keyword.other.name
//                            ^ variable
//                             ^ punctuation.terminator.statement
//                               ^^^^^^^ storage.type
//                                       ^ variable
//                                        ^ punctuation.terminator.statement
               k:= k+k;
//             ^ variable
//              ^^ keyword.operator.assignment
//                 ^ variable
//                  ^ keyword.operator.arithmetic
//                   ^ variable
//                    ^ punctuation.terminator.statement

         Integer i ;
//       ^^^^^^^ storage.type
//               ^ variable
//                 ^ punctuation.terminator.statement

         P(R);
//       ^ entity.name.function
//        ^ punctuation.section.parens
//         ^ variable
//          ^ punctuation.section.parens
//           ^ punctuation.terminator.statement
   End;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   Ref(A) x;
// ^^^ storage.modifier
//    ^ punctuation.section.parens
//     ^ entity.name.class
//      ^ punctuation.section.parens
//        ^ variable
//         ^ punctuation.terminator.statement

   Outtext ("--- START Simula a.s. TEST 73") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^ punctuation.terminator.statement
   Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
   Outtext ("--- Test of formal procedures");
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
   Outimage ; Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
//            ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   i:= 1;
// ^ variable
//  ^^ keyword.operator.assignment
//     ^ constant.numeric.decimal
//      ^ punctuation.terminator.statement
   x:- New A;
// ^ variable
//  ^^ keyword.operator.assignment
//     ^^^ keyword.control.new
//         ^ entity.name.class
//          ^ punctuation.terminator.statement
   Inspect x do P(R);
// ^^^^^^^ keyword.control.inspect
//         ^ variable
//           ^^ keyword.control.do
//              ^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement

   P(x.R);
// ^ entity.name.function
//  ^ punctuation.section.parens
//   ^ variable
//    ^ punctuation.accessor
//     ^ variable
//      ^ punctuation.section.parens
//       ^ punctuation.terminator.statement

   IF i = 8 THEN
// ^^ keyword.control.if
//    ^ variable
//      ^ keyword.operator.comparison
//        ^ constant.numeric.decimal
//          ^^^^ keyword.control.then
   BEGIN
// ^^^^^ keyword.control.begin
      Outtext ("--- NO ERRORS FOUND IN THIS TEST") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
      Outimage
//    ^^^^^^^^ variable
   END Else
// ^^^ keyword.control.end
//     ^^^^ keyword.control.else
   Begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Formal procedures.") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Erroneus values:  i   = ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                   ^ punctuation.section.parens
//                                                     ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outint (i, 5) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("                              x.i = ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                   ^ punctuation.section.parens
//                                                     ^ punctuation.terminator.statement
      if x =/= none then
//    ^^ keyword.control.if
//       ^ variable
//         ^^^ keyword.operator.comparison
//             ^^^^ constant.language.null
//                  ^^^^ keyword.control.then
         Outint (x.i, 5)
//       ^^^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable
//                ^ punctuation.accessor
//                 ^ variable
//                  ^ punctuation.separator
//                    ^ constant.numeric.decimal
//                     ^ punctuation.section.parens
      else
//    ^^^^ keyword.control.else
         Outtext (" object none") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^ string.quoted.double
//                              ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
      Outimage; Outimage
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
//              ^^^^^^^^ variable
   End;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 73") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
 END
// <~--- keyword.control.end
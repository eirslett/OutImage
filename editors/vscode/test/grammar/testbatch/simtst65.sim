BEGIN
// <----- keyword.control.begin
   Boolean found_error ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   Text array lines, facit (1:50) ;
// ^^^^ storage.type
//      ^^^^^ storage.type
//            ^^^^^ variable
//                 ^ punctuation.separator
//                   ^^^^^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ constant.numeric.decimal
//                           ^ punctuation.separator
//                            ^^ constant.numeric.decimal
//                              ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
   Integer lnr ;
// ^^^^^^^ storage.type
//         ^^^ variable
//             ^ punctuation.terminator.statement

   Procedure SaveLine ;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^ entity.name.function
//                    ^ punctuation.terminator.statement
   BEGIN
// ^^^^^ keyword.control.begin
      lnr := lnr + 1 ;
//    ^^^ variable
//        ^^ keyword.operator.assignment
//           ^^^ variable
//               ^ keyword.operator.arithmetic
//                 ^ constant.numeric.decimal
//                   ^ punctuation.terminator.statement
      lines (lnr) :- copy (sysout.image.strip) ;
//    ^^^^^ entity.name.function
//          ^ punctuation.section.parens
//           ^^^ variable
//              ^ punctuation.section.parens
//                ^^ keyword.operator.assignment
//                   ^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^^^^^^ variable
//                               ^ punctuation.accessor
//                                ^^^^^ variable
//                                     ^ punctuation.accessor
//                                      ^^^^^ variable
//                                           ^ punctuation.section.parens
//                                             ^ punctuation.terminator.statement
      sysout.image.setpos (1) ;
//    ^^^^^^ variable
//          ^ punctuation.accessor
//           ^^^^^ variable
//                ^ punctuation.accessor
//                 ^^^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^ constant.numeric.decimal
//                          ^ punctuation.section.parens
//                            ^ punctuation.terminator.statement
      sysout.image := notext
//    ^^^^^^ variable
//          ^ punctuation.accessor
//           ^^^^^ variable
//                 ^^ keyword.operator.assignment
//                    ^^^^^^ constant.language.null
   END pros. saveline ;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^^^ comment.block
//                    ^ punctuation.terminator.statement


   procedure Checklines (n, enr) ;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable.parameter
//                        ^ punctuation.separator
//                          ^^^ variable.parameter
//                             ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
      integer n, enr ;
//    ^^^^^^^ storage.type
//            ^ variable
//             ^ punctuation.separator
//               ^^^ variable
//                   ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      Boolean OK ;
//    ^^^^^^^ storage.type
//            ^^ variable
//               ^ punctuation.terminator.statement
      integer i ;
//    ^^^^^^^ storage.type
//            ^ variable
//              ^ punctuation.terminator.statement

      OK := true ;
//    ^^ variable
//       ^^ keyword.operator.assignment
//          ^^^^ constant.language.bool
//               ^ punctuation.terminator.statement

      for i := 1 step 1 until n do
//    ^^^ keyword.control.for
//        ^ variable
//          ^^ keyword.operator.assignment
//             ^ constant.numeric.decimal
//               ^^^^ keyword.control.step
//                    ^ constant.numeric.decimal
//                      ^^^^^ keyword.control.until
//                            ^ variable
//                              ^^ keyword.control.do
      if facit (i) <> lines (i) then OK := false ;
//    ^^ keyword.control.if
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable
//               ^ punctuation.section.parens
//                 ^^ keyword.operator.comparison
//                    ^^^^^ entity.name.function
//                          ^ punctuation.section.parens
//                           ^ variable
//                            ^ punctuation.section.parens
//                              ^^^^ keyword.control.then
//                                   ^^ variable
//                                      ^^ keyword.operator.assignment
//                                         ^^^^^ constant.language.bool
//                                               ^ punctuation.terminator.statement

      if not OK then
//    ^^ keyword.control.if
//       ^^^ keyword.operator
//           ^^ variable
//              ^^^^ keyword.control.then
      begin
//    ^^^^^ keyword.control.begin
         Outtext ("*** ERROR : Value of attributes (") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                   ^ punctuation.section.parens
//                                                     ^ punctuation.terminator.statement
         Outint (enr, if enr < 10 then 1 else 2) ;
//       ^^^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^ variable
//                  ^ punctuation.separator
//                    ^^ keyword.control.if
//                       ^^^ variable
//                           ^ keyword.operator.comparison
//                             ^^ constant.numeric.decimal
//                                ^^^^ keyword.control.then
//                                     ^ constant.numeric.decimal
//                                       ^^^^ keyword.control.else
//                                            ^ constant.numeric.decimal
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
         Outtext (").") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^ string.quoted.double
//                    ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
         Outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         Outtext ("            Erroneus values : ") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                ^ punctuation.section.parens
//                                                  ^ punctuation.terminator.statement
         Outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         for i := 1 step 1 until n do
//       ^^^ keyword.control.for
//           ^ variable
//             ^^ keyword.operator.assignment
//                ^ constant.numeric.decimal
//                  ^^^^ keyword.control.step
//                       ^ constant.numeric.decimal
//                         ^^^^^ keyword.control.until
//                               ^ variable
//                                 ^^ keyword.control.do
         begin
//       ^^^^^ keyword.control.begin
            Outtext ("            ") ;
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^^^^^^^^^^ string.quoted.double
//                                 ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
            Outchar ('"') ;
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ constant.character
//                      ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
            Outtext (lines (i)) ;
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ variable
//                           ^^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
            Outchar ('"') ;
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ constant.character
//                      ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
            Outimage ;
//          ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement
         end ;
//       ^^^ keyword.control.end
//           ^ punctuation.terminator.statement
         Outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         found_error := true
//       ^^^^^^^^^^^ variable
//                   ^^ keyword.operator.assignment
//                      ^^^^ constant.language.bool
      end ;
//    ^^^ keyword.control.end
//        ^ punctuation.terminator.statement
   end pros. checklines ;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^^^^^ comment.block
//                      ^ punctuation.terminator.statement

   procedure ClearLines ;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^^ entity.name.function
//                      ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      integer i ;
//    ^^^^^^^ storage.type
//            ^ variable
//              ^ punctuation.terminator.statement

      for i := 1 step 1 until 20 do
//    ^^^ keyword.control.for
//        ^ variable
//          ^^ keyword.operator.assignment
//             ^ constant.numeric.decimal
//               ^^^^ keyword.control.step
//                    ^ constant.numeric.decimal
//                      ^^^^^ keyword.control.until
//                            ^^ constant.numeric.decimal
//                               ^^ keyword.control.do
         facit (i) :- lines (i) :- notext ;
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable
//               ^ punctuation.section.parens
//                 ^^ keyword.operator.assignment
//                    ^^^^^ entity.name.function
//                          ^ punctuation.section.parens
//                           ^ variable
//                            ^ punctuation.section.parens
//                              ^^ keyword.operator.assignment
//                                 ^^^^^^ constant.language.null
//                                        ^ punctuation.terminator.statement

      lnr := 0 ;
//    ^^^ variable
//        ^^ keyword.operator.assignment
//           ^ constant.numeric.decimal
//             ^ punctuation.terminator.statement
   end  pros. clearlines ;
// ^^^ keyword.control.end
//      ^^^^^^^^^^^^^^^^ comment.block
//                       ^ punctuation.terminator.statement


   Class Q (ra, rb, t, ra1, rb1, b1, c1, i1, r1, t1) ;
// ^^^^^ keyword.other.class
//       ^ entity.name.class
//         ^ punctuation.section.parens
//          ^^ variable.parameter
//            ^ punctuation.separator
//              ^^ variable.parameter
//                ^ punctuation.separator

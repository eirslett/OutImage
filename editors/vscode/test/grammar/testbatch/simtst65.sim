//                             ^ punctuation.separator
//                               ^^ variable.parameter
//                                 ^ punctuation.separator
//                                   ^^ variable.parameter
//                                     ^ punctuation.separator
//                                       ^^ variable.parameter
//                                         ^ punctuation.separator
//                                           ^^ variable.parameter
//                                             ^ punctuation.separator
//                                               ^^ variable.parameter
//                                                 ^ punctuation.section.parens
//                                                   ^ punctuation.terminator.statement
      Ref (A)          ra ;
//    ^^^ storage.modifier
//        ^ punctuation.section.parens
//         ^ entity.name.class
//          ^ punctuation.section.parens
//                     ^^ variable
//                        ^ punctuation.terminator.statement
      Ref (B)          rb ;
//    ^^^ storage.modifier
//        ^ punctuation.section.parens
//         ^ entity.name.class
//          ^ punctuation.section.parens
//                     ^^ variable
//                        ^ punctuation.terminator.statement
      Text              t ;
//    ^^^^ storage.type
//                      ^ variable
//                        ^ punctuation.terminator.statement
      Ref (A)   array ra1 ;
//    ^^^ storage.modifier
//        ^ punctuation.section.parens
//         ^ entity.name.class
//          ^ punctuation.section.parens
//              ^^^^^ storage.type
//                    ^^^ variable
//                        ^ punctuation.terminator.statement
      Ref (B)   array rb1 ;
//    ^^^ storage.modifier
//        ^ punctuation.section.parens
//         ^ entity.name.class
//          ^ punctuation.section.parens
//              ^^^^^ storage.type
//                    ^^^ variable
//                        ^ punctuation.terminator.statement
      Boolean   array  b1 ;
//    ^^^^^^^ storage.type
//              ^^^^^ storage.type
//                     ^^ variable
//                        ^ punctuation.terminator.statement
      Character array  c1 ;
//    ^^^^^^^^^ storage.type
//              ^^^^^ storage.type
//                     ^^ variable
//                        ^ punctuation.terminator.statement
      Integer   array  i1 ;
//    ^^^^^^^ storage.type
//              ^^^^^ storage.type
//                     ^^ variable
//                        ^ punctuation.terminator.statement
      Real      array  r1 ;
//    ^^^^ storage.type
//              ^^^^^ storage.type
//                     ^^ variable
//                        ^ punctuation.terminator.statement
      Text      array  t1 ;
//    ^^^^ storage.type
//              ^^^^^ storage.type
//                     ^^ variable
//                        ^ punctuation.terminator.statement
   BEGIN
// ^^^^^ keyword.control.begin
      Integer         z ;
//    ^^^^^^^ storage.type
//                    ^ variable
//                      ^ punctuation.terminator.statement

      Outtext ("**ENTER Q") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^ string.quoted.double
//                        ^ punctuation.section.parens
//                          ^ punctuation.terminator.statement
      SaveLine ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement

      Outtext (ra.t) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ variable
//               ^ punctuation.accessor
//                ^ variable
//                 ^ punctuation.section.parens
//                   ^ punctuation.terminator.statement
      Outchar (' ') ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^ constant.character
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outtext (rb.t) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ variable
//               ^ punctuation.accessor
//                ^ variable
//                 ^ punctuation.section.parens
//                   ^ punctuation.terminator.statement
      Outchar (' ') ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^ constant.character
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outtext (t) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.section.parens
//                ^ punctuation.terminator.statement
      SaveLine ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement

      While  z <= 1  do
//    ^^^^^ keyword.control.while
//           ^ variable
//             ^^ keyword.operator.comparison
//                ^ constant.numeric.decimal
//                   ^^ keyword.control.do
      BEGIN
//    ^^^^^ keyword.control.begin
         Outtext (ra1 (z).t) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable
//                      ^ punctuation.section.parens
//                       ^ punctuation.accessor
//                        ^ variable
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         Outchar (' ') ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^ constant.character
//                   ^ punctuation.section.parens
//                     ^ punctuation.terminator.statement
         Outtext (rb1 (z).t) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable
//                      ^ punctuation.section.parens
//                       ^ punctuation.accessor
//                        ^ variable
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         Outchar (' ') ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^ constant.character
//                   ^ punctuation.section.parens
//                     ^ punctuation.terminator.statement
         Outtext (t1 (z)) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^^ punctuation.section.parens
//                        ^ punctuation.terminator.statement

         If  b1 (z)  then Outtext ("true  ") else Outtext ("false ") ;
//       ^^ keyword.control.if
//           ^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable
//                ^ punctuation.section.parens
//                   ^^^^ keyword.control.then
//                        ^^^^^^^ entity.name.function
//                                ^ punctuation.section.parens
//                                 ^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^^^^ keyword.control.else
//                                                ^^^^^^^ entity.name.function
//                                                        ^ punctuation.section.parens
//                                                         ^^^^^^^^ string.quoted.double
//                                                                 ^ punctuation.section.parens
//                                                                   ^ punctuation.terminator.statement
         Outchar (c1 (z)) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
         Outint (i1 (z), 4) ;
//       ^^^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                    ^ punctuation.section.parens
//                     ^ punctuation.separator
//                       ^ constant.numeric.decimal
//                        ^ punctuation.section.parens
//                          ^ punctuation.terminator.statement
         Outreal (r1 (z), 5, 12) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.section.parens
//                      ^ punctuation.separator
//                        ^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
         SaveLine ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement

         z := z + 1
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//              ^ keyword.operator.arithmetic
//                ^ constant.numeric.decimal
      END ;
//    ^^^ keyword.control.end
//        ^ punctuation.terminator.statement

                                           Comment  Now alter parameter values;
//                                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
      ra.t :- rb.t :- t :- Copy ("XXX") ;
//    ^^ variable
//      ^ punctuation.accessor
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^^ variable
//              ^ punctuation.accessor
//               ^ variable
//                 ^^ keyword.operator.assignment
//                    ^ variable
//                      ^^ keyword.operator.assignment
//                         ^^^^ entity.name.function
//                              ^ punctuation.section.parens
//                               ^^^^^ string.quoted.double
//                                    ^ punctuation.section.parens
//                                      ^ punctuation.terminator.statement
      z := 0 ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ constant.numeric.decimal
//           ^ punctuation.terminator.statement

      While  z <= 1  do
//    ^^^^^ keyword.control.while
//           ^ variable
//             ^^ keyword.operator.comparison
//                ^ constant.numeric.decimal
//                   ^^ keyword.control.do
      BEGIN
//    ^^^^^ keyword.control.begin
         ra1 (z).t := rb1 (z).t := t1 (z) := "XXX" ;
//       ^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.section.parens
//              ^ punctuation.accessor
//               ^ variable
//                 ^^ keyword.operator.assignment
//                    ^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^ variable
//                          ^ punctuation.section.parens
//                           ^ punctuation.accessor
//                            ^ variable
//                              ^^ keyword.operator.assignment
//                                 ^^ entity.name.function
//                                    ^ punctuation.section.parens
//                                     ^ variable
//                                      ^ punctuation.section.parens
//                                        ^^ keyword.operator.assignment
//                                           ^^^^^ string.quoted.double
//                                                 ^ punctuation.terminator.statement
         b1 (z) :=  NOT b1 (z) ;
//       ^^ entity.name.function
//          ^ punctuation.section.parens
//           ^ variable
//            ^ punctuation.section.parens
//              ^^ keyword.operator.assignment
//                  ^^^ keyword.operator
//                      ^^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
         c1 (z) := 'X' ;
//       ^^ entity.name.function
//          ^ punctuation.section.parens
//           ^ variable
//            ^ punctuation.section.parens
//              ^^ keyword.operator.assignment
//                 ^^^ constant.character
//                     ^ punctuation.terminator.statement
         i1 (z) := -i1 (z) ;
//       ^^ entity.name.function
//          ^ punctuation.section.parens
//           ^ variable
//            ^ punctuation.section.parens
//              ^^ keyword.operator.assignment
//                 ^ keyword.operator.arithmetic
//                  ^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ variable
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
         r1 (z) := -r1 (z) ;
//       ^^ entity.name.function
//          ^ punctuation.section.parens
//           ^ variable
//            ^ punctuation.section.parens
//              ^^ keyword.operator.assignment
//                 ^ keyword.operator.arithmetic
//                  ^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ variable
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
         z := z + 1
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//              ^ keyword.operator.arithmetic
//                ^ constant.numeric.decimal
      END ;
//    ^^^ keyword.control.end
//        ^ punctuation.terminator.statement

      Outtext ("**EXIT FROM Q") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^ string.quoted.double
//                            ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
      SaveLine ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
   END of class Q ;

// SYNTAX TEST "source.simula" "simtst34"
% ===================================   Main   program =============
// <-------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 34
// <-------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     Test procedures with procedures as parameters.
// <-------------------------------------------------------------- comment.directive
%
// <- comment.directive
%  WRITTEN BY:  BEH   22/07-86
// <------------------------------ comment.directive
% =================================================================
// <------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   Boolean found_error;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                    ^ punctuation.terminator.statement
   Boolean bool;
// ^^^^^^^ storage.type
//         ^^^^ variable
//             ^ punctuation.terminator.statement

   Procedure P (F, a); name F, a; Procedure F; Boolean a;
// ^^^^^^^^^ storage.type
//           ^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable.parameter
//               ^ punctuation.separator
//                 ^ variable.parameter
//                  ^ punctuation.section.parens
//                   ^ punctuation.terminator.statement
//                     ^^^^ keyword.other.name
//                          ^ variable
//                           ^ punctuation.separator
//                             ^ variable
//                              ^ punctuation.terminator.statement
//                                ^^^^^^^^^ storage.type
//                                          ^ entity.name.function
//                                           ^ punctuation.terminator.statement
//                                             ^^^^^^^ storage.type
//                                                     ^ variable
//                                                      ^ punctuation.terminator.statement
   begin Boolean bool;
// ^^^^^ keyword.control.begin
//       ^^^^^^^ storage.type
//               ^^^^ variable
//                   ^ punctuation.terminator.statement
         a := not a;
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^^^ keyword.operator
//                ^ variable
//                 ^ punctuation.terminator.statement
         if a then P2 (F)
//       ^^ keyword.control.if
//          ^ variable
//            ^^^^ keyword.control.then
//                 ^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable
//                      ^ punctuation.section.parens
         else F;
//       ^^^^ keyword.control.else
//            ^ variable
//             ^ punctuation.terminator.statement
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   procedure P2 (F); procedure F;
// ^^^^^^^^^ storage.type
//           ^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable.parameter
//                ^ punctuation.section.parens
//                 ^ punctuation.terminator.statement
//                   ^^^^^^^^^ storage.type
//                             ^ entity.name.function
//                              ^ punctuation.terminator.statement
   begin Boolean a;
// ^^^^^ keyword.control.begin
//       ^^^^^^^ storage.type
//               ^ variable
//                ^ punctuation.terminator.statement
         a := true;
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^^^^ constant.language.bool
//                ^ punctuation.terminator.statement
         P (F, a);
//       ^ entity.name.function
//         ^ punctuation.section.parens
//          ^ variable
//           ^ punctuation.separator
//             ^ variable
//              ^ punctuation.section.parens
//               ^ punctuation.terminator.statement

         bool := true;
//       ^^^^ variable
//            ^^ keyword.operator.assignment
//               ^^^^ constant.language.bool
//                   ^ punctuation.terminator.statement
         if bool then P(Q1,bool) else P(Q2,bool);
//       ^^ keyword.control.if
//          ^^^^ variable
//               ^^^^ keyword.control.then
//                    ^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^^ variable
//                        ^ punctuation.separator
//                         ^^^^ variable
//                             ^ punctuation.section.parens
//                               ^^^^ keyword.control.else
//                                    ^ entity.name.function
//                                     ^ punctuation.section.parens
//                                      ^^ variable
//                                        ^ punctuation.separator
//                                         ^^^^ variable
//                                             ^ punctuation.section.parens
//                                              ^ punctuation.terminator.statement
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   procedure P3 (F, a); name F; procedure F; Boolean a;
// ^^^^^^^^^ storage.type
//           ^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable.parameter
//                ^ punctuation.separator
//                  ^ variable.parameter
//                   ^ punctuation.section.parens
//                    ^ punctuation.terminator.statement
//                      ^^^^ keyword.other.name
//                           ^ variable
//                            ^ punctuation.terminator.statement
//                              ^^^^^^^^^ storage.type
//                                        ^ entity.name.function
//                                         ^ punctuation.terminator.statement
//                                           ^^^^^^^ storage.type
//                                                   ^ variable
//                                                    ^ punctuation.terminator.statement
   begin if a then P4 (F)
// ^^^^^ keyword.control.begin
//       ^^ keyword.control.if
//          ^ variable
//            ^^^^ keyword.control.then
//                 ^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable
//                      ^ punctuation.section.parens
         else F
//       ^^^^ keyword.control.else
//            ^ variable
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   procedure P4 (F); name F; procedure F;
// ^^^^^^^^^ storage.type
//           ^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable.parameter
//                ^ punctuation.section.parens
//                 ^ punctuation.terminator.statement
//                   ^^^^ keyword.other.name
//                        ^ variable
//                         ^ punctuation.terminator.statement
//                           ^^^^^^^^^ storage.type
//                                     ^ entity.name.function
//                                      ^ punctuation.terminator.statement
   begin bool := not bool;
// ^^^^^ keyword.control.begin
//       ^^^^ variable
//            ^^ keyword.operator.assignment
//               ^^^ keyword.operator
//                   ^^^^ variable
//                       ^ punctuation.terminator.statement
         P3 (F, false)
//       ^^ entity.name.function
//          ^ punctuation.section.parens
//           ^ variable
//            ^ punctuation.separator
//              ^^^^^ constant.language.bool
//                   ^ punctuation.section.parens
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   procedure Q1;
// ^^^^^^^^^ storage.type
//           ^^ entity.name.function
//             ^ punctuation.terminator.statement
   begin if bool then
// ^^^^^ keyword.control.begin
//       ^^ keyword.control.if
//          ^^^^ variable
//               ^^^^ keyword.control.then
         begin Outtext ("*** ERROR : Wrong procedure called (1).");
//       ^^^^^ keyword.control.begin
//             ^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                               ^ punctuation.section.parens
//                                                                ^ punctuation.terminator.statement
               Outimage;
//             ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement
               found_error := true
//             ^^^^^^^^^^^ variable
//                         ^^ keyword.operator.assignment
//                            ^^^^ constant.language.bool
         end
//       ^^^ keyword.control.end
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   integer procedure Q2;
// ^^^^^^^ storage.type
//         ^^^^^^^^^ storage.type
//                   ^^ entity.name.function
//                     ^ punctuation.terminator.statement
   begin if bool then  !***OK***;
// ^^^^^ keyword.control.begin
//       ^^ keyword.control.if
//          ^^^^ variable
//               ^^^^ keyword.control.then
//                     ^^^^^^^^^^ comment.block
         else
//       ^^^^ keyword.control.else
         begin Outtext ("*** ERROR : Wrong procedure called (2).");
//       ^^^^^ keyword.control.begin
//             ^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                               ^ punctuation.section.parens
//                                                                ^ punctuation.terminator.statement
               Outimage;
//             ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement
               found_error := true
//             ^^^^^^^^^^^ variable
//                         ^^ keyword.operator.assignment
//                            ^^^^ constant.language.bool
         end
//       ^^^ keyword.control.end
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   Outtext ("--- START Simula a.s. TEST 34");
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
   Outimage;
// ^^^^^^^^ variable
//         ^ punctuation.terminator.statement
   Outtext ("--- Test procedures with procedures as parameters");
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                             ^ punctuation.section.parens
//                                                              ^ punctuation.terminator.statement
   Outimage; Outimage;
// ^^^^^^^^ variable
//         ^ punctuation.terminator.statement
//           ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement

   if bool then P(Q1,bool) else P(Q2,bool);
// ^^ keyword.control.if
//    ^^^^ variable
//         ^^^^ keyword.control.then
//              ^ entity.name.function
//               ^ punctuation.section.parens
//                ^^ variable
//                  ^ punctuation.separator
//                   ^^^^ variable
//                       ^ punctuation.section.parens
//                         ^^^^ keyword.control.else
//                              ^ entity.name.function
//                               ^ punctuation.section.parens
//                                ^^ variable
//                                  ^ punctuation.separator
//                                   ^^^^ variable
//                                       ^ punctuation.section.parens
//                                        ^ punctuation.terminator.statement

   if bool then P3(Q1,true) else P3(Q2,true);
// ^^ keyword.control.if
//    ^^^^ variable
//         ^^^^ keyword.control.then
//              ^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^ variable
//                   ^ punctuation.separator
//                    ^^^^ constant.language.bool
//                        ^ punctuation.section.parens
//                          ^^^^ keyword.control.else
//                               ^^ entity.name.function
//                                 ^ punctuation.section.parens
//                                  ^^ variable
//                                    ^ punctuation.separator
//                                     ^^^^ constant.language.bool
//                                         ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement

   IF found_error THEN
// ^^ keyword.control.if
//    ^^^^^^^^^^^ variable
//                ^^^^ keyword.control.then
   ELSE BEGIN
// ^^^^ keyword.control.else
//      ^^^^^ keyword.control.begin
         Outtext ("--- NO ERRORS FOUND IN THIS TEST");
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                  ^ punctuation.section.parens
//                                                   ^ punctuation.terminator.statement
         Outimage
//       ^^^^^^^^ variable
   END;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 34");
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                        ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
 END
// <~--- keyword.control.end
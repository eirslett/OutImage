// <------------------------------------------------------------------------ comment.directive
Begin
// <----- keyword.control.begin
   Boolean found_error;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                    ^ punctuation.terminator.statement

   text array lines, facit (1:20);
// ^^^^ storage.type
//      ^^^^^ storage.type
//            ^^^^^ variable
//                 ^ punctuation.separator
//                   ^^^^^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ constant.numeric.decimal
//                           ^ punctuation.separator
//                            ^^ constant.numeric.decimal
//                              ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
   integer lnr;
// ^^^^^^^ storage.type
//         ^^^ variable
//            ^ punctuation.terminator.statement

   procedure SaveLine;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^ entity.name.function
//                   ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      lnr := lnr + 1;
//    ^^^ variable
//        ^^ keyword.operator.assignment
//           ^^^ variable
//               ^ keyword.operator.arithmetic
//                 ^ constant.numeric.decimal
//                  ^ punctuation.terminator.statement
      lines (lnr) :- copy (sysout.image.strip);
//    ^^^^^ entity.name.function
//          ^ punctuation.section.parens
//           ^^^ variable
//              ^ punctuation.section.parens
//                ^^ keyword.operator.assignment
//                   ^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^^^^^^ variable
//                               ^ punctuation.accessor
//                                ^^^^^ variable
//                                     ^ punctuation.accessor
//                                      ^^^^^ variable
//                                           ^ punctuation.section.parens
//                                            ^ punctuation.terminator.statement
      sysout.image.setpos (1);
//    ^^^^^^ variable
//          ^ punctuation.accessor
//           ^^^^^ variable
//                ^ punctuation.accessor
//                 ^^^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^ constant.numeric.decimal
//                          ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
      sysout.image := notext
//    ^^^^^^ variable
//          ^ punctuation.accessor
//           ^^^^^ variable
//                 ^^ keyword.operator.assignment
//                    ^^^^^^ constant.language.null
   end;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

   procedure Checklines (n, enr);
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable.parameter
//                        ^ punctuation.separator
//                          ^^^ variable.parameter
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
      integer n, enr;
//    ^^^^^^^ storage.type
//            ^ variable
//             ^ punctuation.separator
//               ^^^ variable
//                  ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      Boolean OK;
//    ^^^^^^^ storage.type
//            ^^ variable
//              ^ punctuation.terminator.statement
      integer i;
//    ^^^^^^^ storage.type
//            ^ variable
//             ^ punctuation.terminator.statement

      OK := true;
//    ^^ variable
//       ^^ keyword.operator.assignment
//          ^^^^ constant.language.bool
//              ^ punctuation.terminator.statement

      for i := 1 step 1 until n do
//    ^^^ keyword.control.for
//        ^ variable
//          ^^ keyword.operator.assignment
//             ^ constant.numeric.decimal
//               ^^^^ keyword.control.step
//                    ^ constant.numeric.decimal
//                      ^^^^^ keyword.control.until
//                            ^ variable
//                              ^^ keyword.control.do
      if facit (i) <> lines (i) then OK := false;
//    ^^ keyword.control.if
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable
//               ^ punctuation.section.parens
//                 ^^ keyword.operator.comparison
//                    ^^^^^ entity.name.function
//                          ^ punctuation.section.parens
//                           ^ variable
//                            ^ punctuation.section.parens
//                              ^^^^ keyword.control.then
//                                   ^^ variable
//                                      ^^ keyword.operator.assignment
//                                         ^^^^^ constant.language.bool
//                                              ^ punctuation.terminator.statement

      if not OK then
//    ^^ keyword.control.if
//       ^^^ keyword.operator
//           ^^ variable
//              ^^^^ keyword.control.then
      begin
//    ^^^^^ keyword.control.begin
         Outtext ("*** ERROR : Value of attributes (");
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                   ^ punctuation.section.parens
//                                                    ^ punctuation.terminator.statement
         Outint (enr, if enr < 10 then 1 else 2);
//       ^^^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^ variable
//                  ^ punctuation.separator
//                    ^^ keyword.control.if
//                       ^^^ variable
//                           ^ keyword.operator.comparison
//                             ^^ constant.numeric.decimal
//                                ^^^^ keyword.control.then
//                                     ^ constant.numeric.decimal
//                                       ^^^^ keyword.control.else
//                                            ^ constant.numeric.decimal
//                                             ^ punctuation.section.parens
//                                              ^ punctuation.terminator.statement
         Outtext (").");
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^ string.quoted.double
//                    ^ punctuation.section.parens
//                     ^ punctuation.terminator.statement
         Outimage;
//       ^^^^^^^^ variable
//               ^ punctuation.terminator.statement
         Outtext ("            Erroneus values : ");
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
         Outimage;
//       ^^^^^^^^ variable
//               ^ punctuation.terminator.statement
         for i := 1 step 1 until n do
//       ^^^ keyword.control.for
//           ^ variable
//             ^^ keyword.operator.assignment
//                ^ constant.numeric.decimal
//                  ^^^^ keyword.control.step
//                       ^ constant.numeric.decimal
//                         ^^^^^ keyword.control.until
//                               ^ variable
//                                 ^^ keyword.control.do
         begin
//       ^^^^^ keyword.control.begin
            Outtext ("            ");
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^^^^^^^^^^ string.quoted.double
//                                 ^ punctuation.section.parens
//                                  ^ punctuation.terminator.statement
            Outchar ('"');
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ constant.character
//                      ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
            Outtext (lines (i));
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^^^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ variable
//                           ^^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
            Outchar ('"');
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ constant.character
//                      ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
            Outimage;
//          ^^^^^^^^ variable
//                  ^ punctuation.terminator.statement
         end;
//       ^^^ keyword.control.end
//          ^ punctuation.terminator.statement
         Outimage;
//       ^^^^^^^^ variable
//               ^ punctuation.terminator.statement
         found_error := true
//       ^^^^^^^^^^^ variable
//                   ^^ keyword.operator.assignment
//                      ^^^^ constant.language.bool
      end;
//    ^^^ keyword.control.end
//       ^ punctuation.terminator.statement
   end pros. checklines;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^^^^^ comment.block
//                     ^ punctuation.terminator.statement

   procedure ClearLines;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^^ entity.name.function
//                     ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      integer i;
//    ^^^^^^^ storage.type
//            ^ variable
//             ^ punctuation.terminator.statement

      for i := 1 step 1 until 20 do
//    ^^^ keyword.control.for
//        ^ variable
//          ^^ keyword.operator.assignment
//             ^ constant.numeric.decimal
//               ^^^^ keyword.control.step
//                    ^ constant.numeric.decimal
//                      ^^^^^ keyword.control.until
//                            ^^ constant.numeric.decimal
//                               ^^ keyword.control.do
         facit (i) :- lines (i) :- notext;
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable
//               ^ punctuation.section.parens
//                 ^^ keyword.operator.assignment
//                    ^^^^^ entity.name.function
//                          ^ punctuation.section.parens
//                           ^ variable
//                            ^ punctuation.section.parens
//                              ^^ keyword.operator.assignment
//                                 ^^^^^^ constant.language.null
//                                       ^ punctuation.terminator.statement

      lnr := 0;
//    ^^^ variable
//        ^^ keyword.operator.assignment
//           ^ constant.numeric.decimal
//            ^ punctuation.terminator.statement
   end  pros. clearlines;
// ^^^ keyword.control.end
//      ^^^^^^^^^^^^^^^^ comment.block
//                      ^ punctuation.terminator.statement


   Class A1 (b);  Boolean b;
// ^^^^^ keyword.other.class
//       ^^ entity.name.class
//          ^ punctuation.section.parens
//           ^ variable.parameter
//            ^ punctuation.section.parens
//             ^ punctuation.terminator.statement
//                ^^^^^^^ storage.type
//                        ^ variable
//                         ^ punctuation.terminator.statement
   Begin
// ^^^^^ keyword.control.begin
      Character     c;
//    ^^^^^^^^^ storage.type
//                  ^ variable
//                   ^ punctuation.terminator.statement
      Integer       i;
//    ^^^^^^^ storage.type
//                  ^ variable
//                   ^ punctuation.terminator.statement
      Real          r;
//    ^^^^ storage.type
//                  ^ variable
//                   ^ punctuation.terminator.statement
      Text          t;
//    ^^^^ storage.type
//                  ^ variable
//                   ^ punctuation.terminator.statement

      Outtext ("  A1 before Inner");
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                ^ punctuation.section.parens
//                                 ^ punctuation.terminator.statement
      SaveLine;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
      b := true;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^^^ constant.language.bool
//             ^ punctuation.terminator.statement
      i := 2;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ constant.numeric.decimal
//          ^ punctuation.terminator.statement
      r := 3;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ constant.numeric.decimal
//          ^ punctuation.terminator.statement
      c := '*';
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^^ constant.character
//            ^ punctuation.terminator.statement
      t :- Copy ("t in A1");
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^^^^^^^ string.quoted.double
//                        ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement

      If b then Outtext ("  true  ") else Outtext ("  false ");
//    ^^ keyword.control.if
//       ^ variable
//         ^^^^ keyword.control.then
//              ^^^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^^^^^^^^^^ string.quoted.double
//                                 ^ punctuation.section.parens
//                                   ^^^^ keyword.control.else
//                                        ^^^^^^^ entity.name.function
//                                                ^ punctuation.section.parens
//                                                 ^^^^^^^^^^ string.quoted.double
//                                                           ^ punctuation.section.parens
//                                                            ^ punctuation.terminator.statement
      Outchar (c);
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.section.parens
//               ^ punctuation.terminator.statement
      Outint (i, 4);
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                 ^ punctuation.terminator.statement
      Outreal (r, 5, 12);
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.separator
//                ^ constant.numeric.decimal
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
      Outchar (' ');
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^ constant.character
//                ^ punctuation.section.parens
//                 ^ punctuation.terminator.statement
      Outtext (t);
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.section.parens
//               ^ punctuation.terminator.statement
      SaveLine;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement

      Inner;
//    ^^^^^ keyword.other.inner
//         ^ punctuation.terminator.statement

      Outtext ("  A1 after  Inner");
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                ^ punctuation.section.parens
//                                 ^ punctuation.terminator.statement
      SaveLine;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
   End of class A1;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^ comment.block
//                ^ punctuation.terminator.statement

   A1 Class A12 (c, i, r, t);  VALUE         t;
// ^^ entity.name.class
//    ^^^^^ keyword.other.class
//          ^^^ entity.name.class
//              ^ punctuation.section.parens

   A1 Class A13 (bv, cv , iv, rv);  VALUE           bv, cv , iv, rv;
// ^^ entity.name.class
//    ^^^^^ keyword.other.class
//          ^^^ entity.name.class
//              ^ punctuation.section.parens
//               ^^ variable.parameter
//                 ^ punctuation.separator
//                   ^^ variable.parameter
//                      ^ punctuation.separator
//                        ^^ variable.parameter
//                          ^ punctuation.separator
//                            ^^ variable.parameter
//                              ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
//                                  ^^^^^ keyword.other.value
//                                                  ^^ variable
//                                                    ^ punctuation.separator
//                                                      ^^ variable
//                                                         ^ punctuation.separator
//                                                           ^^ variable
//                                                             ^ punctuation.separator
//                                                               ^^ variable
//                                                                 ^ punctuation.terminator.statement
                                     Boolean   ARRAY bv;
//                                   ^^^^^^^ storage.type
//                                             ^^^^^ storage.type
//                                                   ^^ variable
//                                                     ^ punctuation.terminator.statement
                                     Character ARRAY cv ;
//                                   ^^^^^^^^^ storage.type
//                                             ^^^^^ storage.type
//                                                   ^^ variable
//                                                      ^ punctuation.terminator.statement
                                     Integer   ARRAY iv;
//                                   ^^^^^^^ storage.type
//                                             ^^^^^ storage.type
//                                                   ^^ variable
//                                                     ^ punctuation.terminator.statement
                                     Real      ARRAY rv;
//                                   ^^^^ storage.type
//                                             ^^^^^ storage.type
//                                                   ^^ variable
//                                                     ^ punctuation.terminator.statement
   Begin
// ^^^^^ keyword.control.begin
      Integer    i;
//    ^^^^^^^ storage.type
//               ^ variable
//                ^ punctuation.terminator.statement

      While  i <= 2  do
//    ^^^^^ keyword.control.while
//           ^ variable
//             ^^ keyword.operator.comparison
//                ^ constant.numeric.decimal
//                   ^^ keyword.control.do
      Begin
//    ^^^^^ keyword.control.begin
         If bv(i) then Outtext("  true  ") else Outtext("  false ");
//       ^^ keyword.control.if
//          ^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.section.parens
//                ^^^^ keyword.control.then
//                     ^^^^^^^ entity.name.function
//                            ^ punctuation.section.parens
//                             ^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^^^^ keyword.control.else
//                                              ^^^^^^^ entity.name.function
//                                                     ^ punctuation.section.parens
//                                                      ^^^^^^^^^^ string.quoted.double
//                                                                ^ punctuation.section.parens
//                                                                 ^ punctuation.terminator.statement
         Outchar (cv (i));
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
         Outint (iv (i), 4);
//       ^^^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                    ^ punctuation.section.parens
//                     ^ punctuation.separator
//                       ^ constant.numeric.decimal
//                        ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
         Outreal (rv (i), 5, 12);
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^ entity.name.function
//                   ^ punctuation.section.parens
//                    ^ variable
//                     ^ punctuation.section.parens
//                      ^ punctuation.separator
//                        ^ constant.numeric.decimal
//                         ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
         SaveLine;
//       ^^^^^^^^ variable
//               ^ punctuation.terminator.statement

         i := i + 1
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//              ^ keyword.operator.arithmetic
//                ^ constant.numeric.decimal
      End;
//    ^^^ keyword.control.end
//       ^ punctuation.terminator.statement

   End of class A13;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^ comment.block
//                 ^ punctuation.terminator.statement

   Class A14 (bv, cv , iv, rv);   VALUE           bv, cv , iv, rv;
// ^^^^^ keyword.other.class
//       ^^^ entity.name.class
//           ^ punctuation.section.parens
//            ^^ variable.parameter
//              ^ punctuation.separator
//                ^^ variable.parameter
//                   ^ punctuation.separator
//                     ^^ variable.parameter
//                       ^ punctuation.separator
//                         ^^ variable.parameter
//                           ^ punctuation.section.parens
//                            ^ punctuation.terminator.statement
//                                ^^^^^ keyword.other.value
//                                                ^^ variable
//                                                  ^ punctuation.separator
//                                                    ^^ variable
//                                                       ^ punctuation.separator
//                                                         ^^ variable
//                                                           ^ punctuation.separator
//                                                             ^^ variable
//                                                               ^ punctuation.terminator.statement
                                   Boolean   ARRAY bv;
//                                 ^^^^^^^ storage.type
//                                           ^^^^^ storage.type
//                                                 ^^ variable
//                                                   ^ punctuation.terminator.statement
                                   Character ARRAY cv ;
//                                 ^^^^^^^^^ storage.type
//                                           ^^^^^ storage.type
//                                                 ^^ variable
//                                                    ^ punctuation.terminator.statement
                                   Integer   ARRAY iv;
//                                 ^^^^^^^ storage.type
//                                           ^^^^^ storage.type
//                                                 ^^ variable
//                                                   ^ punctuation.terminator.statement
                                   Real      ARRAY rv;
//                                 ^^^^ storage.type
//                                           ^^^^^ storage.type
//                                                 ^^ variable
//                                                   ^ punctuation.terminator.statement
   Begin
// ^^^^^ keyword.control.begin
      Integer    i, j;
//    ^^^^^^^ storage.type
//               ^ variable
//                ^ punctuation.separator
//                  ^ variable
//                   ^ punctuation.terminator.statement

      While  i <= 2  do
//    ^^^^^ keyword.control.while
//           ^ variable
//             ^^ keyword.operator.comparison
//                ^ constant.numeric.decimal
//                   ^^ keyword.control.do
      Begin
//    ^^^^^ keyword.control.begin
         j := 0;
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^ constant.numeric.decimal
//             ^ punctuation.terminator.statement

         While  j <= 3  do
//       ^^^^^ keyword.control.while
//              ^ variable
//                ^^ keyword.operator.comparison
//                   ^ constant.numeric.decimal
//                      ^^ keyword.control.do
         Begin
//       ^^^^^ keyword.control.begin
            If bv (i,j) then Outtext("  true  ")
//          ^^ keyword.control.if
//             ^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.separator
//                   ^ variable
//                    ^ punctuation.section.parens
//                      ^^^^ keyword.control.then
//                           ^^^^^^^ entity.name.function
//                                  ^ punctuation.section.parens
//                                   ^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
            else Outtext("  false ");
//          ^^^^ keyword.control.else
//               ^^^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^^^^^^^^^^ string.quoted.double
//                                 ^ punctuation.section.parens
//                                  ^ punctuation.terminator.statement
            Outchar (cv (i, j));
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable
//                        ^ punctuation.separator
//                          ^ variable
//                           ^^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
            Outint (iv (i, j), 4);
//          ^^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ variable
//                       ^ punctuation.separator
//                         ^ variable
//                          ^ punctuation.section.parens
//                           ^ punctuation.separator
//                             ^ constant.numeric.decimal
//                              ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
            Outreal (rv (i, j), 5, 12);
//          ^^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable
//                        ^ punctuation.separator
//                          ^ variable
//                           ^ punctuation.section.parens
//                            ^ punctuation.separator
//                              ^ constant.numeric.decimal
//                               ^ punctuation.separator
//                                 ^^ constant.numeric.decimal
//                                   ^ punctuation.section.parens

// SYNTAX TEST "source.simula" "simtst71"
% ===============================================   Main   program =============
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 71
// <-------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     Test visibility of identifiers.
// <----------------------------------------------- comment.directive
%
// <- comment.directive
%  WRITTEN BY:  BEH   22/08-86
// <------------------------------ comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   Boolean found_error ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   integer i;
// ^^^^^^^ storage.type
//         ^ variable
//          ^ punctuation.terminator.statement

   Class A ;
// ^^^^^ keyword.other.class
//       ^ entity.name.class
//         ^ punctuation.terminator.statement
      Virtual : Procedure P1;
//    ^^^^^^^ keyword.other.virtual
//            ^ punctuation.separator
//              ^^^^^^^^^ storage.type
//                        ^^ entity.name.function
//                          ^ punctuation.terminator.statement
   BEGIN
// ^^^^^ keyword.control.begin
      Procedure P1; i := 1;
//    ^^^^^^^^^ storage.type
//              ^^ entity.name.function
//                ^ punctuation.terminator.statement
//                  ^ variable
//                    ^^ keyword.operator.assignment
//                       ^ constant.numeric.decimal
//                        ^ punctuation.terminator.statement
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   A Class B ;
// ^ entity.name.class
//   ^^^^^ keyword.other.class
//         ^ entity.name.class
//           ^ punctuation.terminator.statement
   BEGIN
// ^^^^^ keyword.control.begin
      Procedure P1; i := 2;
//    ^^^^^^^^^ storage.type
//              ^^ entity.name.function
//                ^ punctuation.terminator.statement
//                  ^ variable
//                    ^^ keyword.operator.assignment
//                       ^ constant.numeric.decimal
//                        ^ punctuation.terminator.statement
      Procedure P2; i := 3;
//    ^^^^^^^^^ storage.type
//              ^^ entity.name.function
//                ^ punctuation.terminator.statement
//                  ^ variable
//                    ^^ keyword.operator.assignment
//                       ^ constant.numeric.decimal
//                        ^ punctuation.terminator.statement
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Ref (A) rA ;
// ^^^ storage.modifier
//     ^ punctuation.section.parens
//      ^ entity.name.class
//       ^ punctuation.section.parens
//         ^^ variable
//            ^ punctuation.terminator.statement

   Procedure P2; i := 4;
// ^^^^^^^^^ storage.type
//           ^^ entity.name.function
//             ^ punctuation.terminator.statement
//               ^ variable
//                 ^^ keyword.operator.assignment
//                    ^ constant.numeric.decimal
//                     ^ punctuation.terminator.statement

   Outtext ("--- START Simula a.s. TEST 71") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^ punctuation.terminator.statement
   Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
   Outtext ("--- Test visibility of identifiers.") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
   Outimage ; Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
//            ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   rA :- new B ;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^^ keyword.control.new
//           ^ entity.name.class
//             ^ punctuation.terminator.statement

   Inspect rA do
// ^^^^^^^ keyword.control.inspect
//         ^^ variable
//            ^^ keyword.control.do
   Begin P2 end;
// ^^^^^ keyword.control.begin
//       ^^ variable
//          ^^^ keyword.control.end
//             ^ punctuation.terminator.statement

   If i = 4 then
// ^^ keyword.control.if
//    ^ variable
//      ^ keyword.operator.comparison
//        ^ constant.numeric.decimal
//          ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   Begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Visibility of identifiers (1).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                         ^ punctuation.section.parens
//                                                           ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Value of i : ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outint (i, 3) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage; Outimage;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
//              ^^^^^^^^ variable
//                      ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   End ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   rA :- new B ;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^^ keyword.control.new
//           ^ entity.name.class
//             ^ punctuation.terminator.statement

   Inspect rA when B do
// ^^^^^^^ keyword.control.inspect
//         ^^ variable
//            ^^^^ keyword.control.when
//                 ^ entity.name.class
//                   ^^ keyword.control.do
   Begin P2 End;
// ^^^^^ keyword.control.begin
//       ^^ variable
//          ^^^ keyword.control.end
//             ^ punctuation.terminator.statement

   If i = 3 then
// ^^ keyword.control.if
//    ^ variable
//      ^ keyword.operator.comparison
//        ^ constant.numeric.decimal
//          ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   Begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Visibility of identifiers (2).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                         ^ punctuation.section.parens
//                                                           ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Value of i : ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outint (i, 3) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage; Outimage;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
//              ^^^^^^^^ variable
//                      ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   End ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement


   rA :- new B;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^^ keyword.control.new
//           ^ entity.name.class
//            ^ punctuation.terminator.statement

   Inspect rA do
// ^^^^^^^ keyword.control.inspect
//         ^^ variable
//            ^^ keyword.control.do
   Begin P1 End;
// ^^^^^ keyword.control.begin
//       ^^ variable
//          ^^^ keyword.control.end
//             ^ punctuation.terminator.statement

   If i = 2 then
// ^^ keyword.control.if
//    ^ variable
//      ^ keyword.operator.comparison
//        ^ constant.numeric.decimal
//          ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   Begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Visibility of identifiers (3).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                         ^ punctuation.section.parens
//                                                           ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Value of i : ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outint (i, 3) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage; Outimage;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
//              ^^^^^^^^ variable
//                      ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   End ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement


   rA :- new A;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^^ keyword.control.new
//           ^ entity.name.class
//            ^ punctuation.terminator.statement

   inspect rA do
// ^^^^^^^ keyword.control.inspect
//         ^^ variable
//            ^^ keyword.control.do
   Begin P1 end;
// ^^^^^ keyword.control.begin
//       ^^ variable
//          ^^^ keyword.control.end
//             ^ punctuation.terminator.statement


   If i = 1 then
// ^^ keyword.control.if
//    ^ variable
//      ^ keyword.operator.comparison
//        ^ constant.numeric.decimal
//          ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   Begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Visibility of identifiers (4).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                         ^ punctuation.section.parens
//                                                           ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Value of i : ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outint (i, 3) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage; Outimage;
//    ^^^^^^^^ variable
//            ^ punctuation.terminator.statement
//              ^^^^^^^^ variable
//                      ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   End ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   IF found_error THEN
// ^^ keyword.control.if
//    ^^^^^^^^^^^ variable
//                ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   BEGIN
// ^^^^^ keyword.control.begin
      Outtext ("--- NO ERRORS FOUND IN THIS TEST") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
      Outimage
//    ^^^^^^^^ variable
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 71") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
 END
// <~--- keyword.control.end
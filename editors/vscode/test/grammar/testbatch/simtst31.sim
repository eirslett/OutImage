BEGIN
// <----- keyword.control.begin
   Boolean found_error;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                    ^ punctuation.terminator.statement

   PROCEDURE P(LFD);  LABEL LFD;
// ^^^^^^^^^ storage.type
//           ^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^ variable.parameter
//                ^ punctuation.section.parens
//                 ^ punctuation.terminator.statement
//                    ^^^^^ keyword.other.label
//                          ^^^ variable
//                             ^ punctuation.terminator.statement
      BEGIN
//    ^^^^^ keyword.control.begin
      b :=  NOT b;
//    ^ variable
//      ^^ keyword.operator.assignment
//          ^^^ keyword.operator
//              ^ variable
//               ^ punctuation.terminator.statement
      GOTO LFD
//    ^^^^ keyword.control.goto
//         ^^^ entity.name.label
   END of procedure P;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^^^ comment.block
//                   ^ punctuation.terminator.statement

   PROCEDURE Q(LFN);  NAME LFN;  LABEL LFN;
// ^^^^^^^^^ storage.type
//           ^ entity.name.function

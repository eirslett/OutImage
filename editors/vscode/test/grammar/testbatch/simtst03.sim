//                 ^^^^^^^^^^^ variable
//                            ^ punctuation.terminator.statement
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                       ! found.                      ;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
INTEGER            maxtext;            ! To contain the maximum text ;
// <------- storage.type
//                 ^^^^^^^ variable
//                        ^ punctuation.terminator.statement
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                       ! constant length.            ;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block

outtext ("--- START Simula a.s. TEST 3");
// <------- entity.name.function
//      ^ punctuation.section.parens
//       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                     ^ punctuation.section.parens
//                                      ^ punctuation.terminator.statement
Outimage;
// <-------- variable
//      ^ punctuation.terminator.statement
outtext ("--- Test text value relations");
// <------- entity.name.function
//      ^ punctuation.section.parens
//       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                      ^ punctuation.section.parens
//                                       ^ punctuation.terminator.statement
Outimage; Outimage;
// <-------- variable
//      ^ punctuation.terminator.statement
//        ^^^^^^^^ variable
//                ^ punctuation.terminator.statement

maxtext := 32000;                      !********* NOTE 1 ************;
// <------- variable
//      ^^ keyword.operator.assignment
//         ^^^^^ constant.numeric.decimal
//              ^ punctuation.terminator.statement
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                       ! Max text constant length    ;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                       ! must be filled in.          ;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block

                                       !*****************************;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                       ! Start with both texts empty ;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                       !*****************************;
//                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
IF t1 <> NOTEXT THEN
// <-- keyword.control.if
// ^^ variable
//    ^^ keyword.operator.comparison
//       ^^^^^^ constant.language.null
//              ^^^^ keyword.control.then
   BEGIN
// ^^^^^ keyword.control.begin
   outtext ("***  Equality between empty texts not recognized (1).");
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                                 ^ punctuation.section.parens
//                                                                  ^ punctuation.terminator.statement
   outimage;
// ^^^^^^^^ variable
//         ^ punctuation.terminator.statement
   found_error := TRUE
// ^^^^^^^^^^^ variable
//             ^^ keyword.operator.assignment
//                ^^^^ constant.language.bool
   END;
// ^^^ keyword.control.end
//    ^ punctuation.terminator.statement

IF t1 = t2 THEN
// <-- keyword.control.if
// ^^ variable
//    ^ keyword.operator.comparison
//      ^^ variable
//         ^^^^ keyword.control.then
ELSE

// SYNTAX TEST "source.simula" "simtst52"
% ===============================================   Main   program =============
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 52
// <-------------------------------------------------- comment.directive
%
// <- comment.directive

// SYNTAX TEST "source.simula" "simtst10"
% ===============================================   Main   program  ============
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   SIMULA A/S - SIMULA TEST NO 10
// <------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     To test the evaluation of text-constants
// <-------------------------------------------------------- comment.directive
%
// <- comment.directive
%  METHOD:      Take some examples and see if we get the expected values.
// <------------------------------------------------------------------------- comment.directive
%
// <- comment.directive
%  WRITTEN BY:  BEH  10/07-86
// <----------------------------- comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   Boolean found_error ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   Outtext ("--- START Simula a.s. TEST 10") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^ punctuation.terminator.statement
   Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
   Outtext ("--- Test the evaluation of text constants.") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                      ^ punctuation.section.parens
//                                                        ^ punctuation.terminator.statement
   Outimage ; Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
//            ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

                                                 !*****************************;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                 ! Test sequence of simple     ;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                 ! strings.                    ;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                 !*****************************;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
   if "Ab" "cde" = "Abcde" then
// ^^ keyword.control.if
//    ^^^^ string.quoted.double
//         ^^^^^ string.quoted.double
//               ^ keyword.operator.comparison
//                 ^^^^^^^ string.quoted.double
//                         ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (1).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   if "AB"
// ^^ keyword.control.if
//    ^^^^ string.quoted.double
           "CDE" = "ABCDE" then
//         ^^^^^ string.quoted.double
//               ^ keyword.operator.comparison
//                 ^^^^^^^ string.quoted.double
//                         ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (2).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   if "Abcde" = "AB" "cde" then
// ^^ keyword.control.if
//    ^^^^^^^ string.quoted.double
//            ^ keyword.operator.comparison
//              ^^^^ string.quoted.double
//                   ^^^^^ string.quoted.double
//                         ^^^^ keyword.control.then
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (3).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement
                                                 !*****************************;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                 ! Test !x!                    ;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                 !*****************************;
//                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
   if "12!32!45" = "12 45" then
// ^^ keyword.control.if
//    ^^^^^^^^^^ string.quoted.double
//               ^ keyword.operator.comparison
//                 ^^^^^^^ string.quoted.double
//                         ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (4).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   if "!345!" = "!33!345!33!" then
// ^^ keyword.control.if
//    ^^^^^^^ string.quoted.double
//            ^ keyword.operator.comparison
//              ^^^^^^^^^^^^^ string.quoted.double
//                            ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (5).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   if "!3" "2!" = "!33!32!33!" then
// ^^ keyword.control.if
//    ^^^^ string.quoted.double
//         ^^^^ string.quoted.double
//              ^ keyword.operator.comparison
//                ^^^^^^^^^^^^ string.quoted.double
//                             ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (6).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

                                                !******************************;
//                                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                ! Test "" in a string.         ;
//                                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
                                                !******************************;
//                                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block
   if "a""b" = "a!34!b" then
// ^^ keyword.control.if
//    ^^^^^^ string.quoted.double
//           ^ keyword.operator.comparison
//             ^^^^^^^^ string.quoted.double
//                      ^^^^ keyword.control.then
   else
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text constant (7).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                             ^ punctuation.section.parens
//                                               ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement


   IF found_error THEN
// ^^ keyword.control.if
//    ^^^^^^^^^^^ variable
//                ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   BEGIN
// ^^^^^ keyword.control.begin
      Outtext ("--- NO ERRORS FOUND IN THIS TEST") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
      Outimage
//    ^^^^^^^^ variable
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 10") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
 END
// <~--- keyword.control.end
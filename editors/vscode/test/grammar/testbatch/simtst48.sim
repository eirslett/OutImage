   Procedure Check (i, t, vi, vt, enr) ; value t, vt ;
// ^^^^^^^^^ storage.type
//           ^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^ variable.parameter
//                   ^ punctuation.separator
//                     ^ variable.parameter
//                      ^ punctuation.separator
//                        ^^ variable.parameter
//                          ^ punctuation.separator
//                            ^^ variable.parameter
//                              ^ punctuation.separator

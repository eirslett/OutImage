comment
// <------- comment.block
************************************************************************
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*               how to use distance simulation program                 *
// <------------------------------------------------------------------------ comment.block
*               **************************************                 *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     purpose:    to find the shortest path through two points in      *
// <------------------------------------------------------------------------ comment.block
*                 a given graph.                                       *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     syntax:                                                          *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     the data deck is treated as a continuous string of characters,   *
// <------------------------------------------------------------------------ comment.block
*     and is of the form                                               *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*                    <map>*<instruction set>                           *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     <map>::=               <crossdata>/<crossdata><map>              *
// <------------------------------------------------------------------------ comment.block
*     <crossdata>::=         <crosspoint><directory>                   *
// <------------------------------------------------------------------------ comment.block
*     <crosspoint>::=        <name>                                    *
// <------------------------------------------------------------------------ comment.block
*     <name>::=              any sequence of characters different      *
// <------------------------------------------------------------------------ comment.block
*                            from blank, not beginning with * or  ,    *
// <------------------------------------------------------------------------ comment.block
*                            and terminated with a blank               *
// <------------------------------------------------------------------------ comment.block
*     <directory>::=         <direction>/<direction><directory>        *
// <------------------------------------------------------------------------ comment.block
*     <direction>::=         <nextpoint><distance>                     *
// <------------------------------------------------------------------------ comment.block
*     <nextpoint>::=         <name>                                    *
// <------------------------------------------------------------------------ comment.block
*     <distance>::=          real constant terminated by a blank       *
// <------------------------------------------------------------------------ comment.block
*     <instruction set>::=   <command>/<command><instruction set>      *
// <------------------------------------------------------------------------ comment.block
*     <command>::=           <entry><exit>                             *
// <------------------------------------------------------------------------ comment.block
*     <entry>::=             <name>                                    *
// <------------------------------------------------------------------------ comment.block
*     <exit>::=              <name>                                    *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     use blanks at will outside smallest syntactic units.             *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     semantics:                                                       *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     <map> provides information upon the points and paths of the      *
// <------------------------------------------------------------------------ comment.block
*     system.                                                          *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     <crossdata> generates the point <crosspoint> and all paths       *
// <------------------------------------------------------------------------ comment.block
*     leading from it.                                                 *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     a path is thus generated leading from <crosspoint> directly to   *
// <------------------------------------------------------------------------ comment.block
*     <nextpoint>, having the length <distance>.  note that a path     *
// <------------------------------------------------------------------------ comment.block
*     leading from <nextpoint> to <crosspoint> must be generated       *
// <------------------------------------------------------------------------ comment.block
*     explicitly, due to possibility of one-way street etc.            *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*     <command> calls for a calculation of shortest path leading from  *
// <------------------------------------------------------------------------ comment.block
*     <entry> to <exit>.  the program will then output intermediate    *
// <------------------------------------------------------------------------ comment.block
*     points, if any, and total length of the path.                    *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
*                                                                      *
// <------------------------------------------------------------------------ comment.block
************************************************************************
// <------------------------------------------------------------------------ comment.block
;
// <- comment.block
      text array answer,ut(1:50); integer utnr,i;
//    ^^^^ storage.type
//         ^^^^^ storage.type
//               ^^^^^^ variable
//                     ^ punctuation.separator
//                      ^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^ constant.numeric.decimal
//                          ^ punctuation.separator
//                           ^^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
//                                ^^^^^^^ storage.type
//                                        ^^^^ variable
//                                            ^ punctuation.separator
//                                             ^ variable
//                                              ^ punctuation.terminator.statement

      procedure Outimage;
//    ^^^^^^^^^ storage.type
//              ^^^^^^^^ entity.name.function
//                      ^ punctuation.terminator.statement
      begin utnr:=utnr+1;
//    ^^^^^ keyword.control.begin
//          ^^^^ variable
//              ^^ keyword.operator.assignment
//                ^^^^ variable
//                    ^ keyword.operator.arithmetic
//                     ^ constant.numeric.decimal
//                      ^ punctuation.terminator.statement
            ut(utnr):-copy(sysout.image.strip);
//          ^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^ variable
//                 ^ punctuation.section.parens
//                  ^^ keyword.operator.assignment
//                    ^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^^^^^^ variable
//                               ^ punctuation.accessor
//                                ^^^^^ variable
//                                     ^ punctuation.accessor
//                                      ^^^^^ variable
//                                           ^ punctuation.section.parens
//                                            ^ punctuation.terminator.statement
            sysout.image:=notext; sysout.setpos(1);
//          ^^^^^^ variable
//                ^ punctuation.accessor
//                 ^^^^^ variable
//                      ^^ keyword.operator.assignment
//                        ^^^^^^ constant.language.null
//                              ^ punctuation.terminator.statement
//                                ^^^^^^ variable
//                                      ^ punctuation.accessor
//                                       ^^^^^^ entity.name.function
//                                             ^ punctuation.section.parens
//                                              ^ constant.numeric.decimal
//                                               ^ punctuation.section.parens
//                                                ^ punctuation.terminator.statement
      end;
//    ^^^ keyword.control.end
//       ^ punctuation.terminator.statement


      process class car(start,destin,dist);
//    ^^^^^^^ entity.name.class
//            ^^^^^ keyword.other.class
//                  ^^^ entity.name.class
//                     ^ punctuation.section.parens
//                      ^^^^^ variable.parameter
//                           ^ punctuation.separator
//                            ^^^^^^ variable.parameter
//                                  ^ punctuation.separator
//                                   ^^^^ variable.parameter
//                                       ^ punctuation.section.parens
//                                        ^ punctuation.terminator.statement

      ref (town)start,destin;
//    ^^^ storage.modifier
//        ^ punctuation.section.parens
//         ^^^^ entity.name.class
//             ^ punctuation.section.parens
//              ^^^^^ variable
//                   ^ punctuation.separator
//                    ^^^^^^ variable
//                          ^ punctuation.terminator.statement
      real dist;
//    ^^^^ storage.type
//         ^^^^ variable
//             ^ punctuation.terminator.statement
      begin ref (head)been;
//    ^^^^^ keyword.control.begin
//          ^^^ storage.modifier
//              ^ punctuation.section.parens
//               ^^^^ entity.name.class
//                   ^ punctuation.section.parens
//                    ^^^^ variable
//                        ^ punctuation.terminator.statement
            procedure send(c);ref (link)c;if c is car then
//          ^^^^^^^^^ storage.type
//                    ^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^ variable.parameter
//                          ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
//                            ^^^ storage.modifier
//                                ^ punctuation.section.parens
//                                 ^^^^ entity.name.class
//                                     ^ punctuation.section.parens
//                                      ^ variable
//                                       ^ punctuation.terminator.statement
//                                        ^^ keyword.control.if
//                                           ^ variable
//                                             ^^ keyword.other.is
//                                                ^^^ variable
//                                                    ^^^^ keyword.control.then
            begin been.first qua townpoint.put(c qua car.been);
//          ^^^^^ keyword.control.begin
//                ^^^^ variable
//                    ^ punctuation.accessor
//                     ^^^^^ variable
//                           ^^^ keyword.operator
//                               ^^^^^^^^^ variable
//                                        ^ punctuation.accessor
//                                         ^^^ entity.name.function
//                                            ^ punctuation.section.parens
//                                             ^ variable
//                                               ^^^ keyword.operator
//                                                   ^^^ variable
//                                                      ^ punctuation.accessor
//                                                       ^^^^ variable
//                                                           ^ punctuation.section.parens
//                                                            ^ punctuation.terminator.statement
                  activate c;
//                ^^^^^^^^ keyword.control.activate
//                         ^ variable
//                          ^ punctuation.terminator.statement
            end ;
//          ^^^ keyword.control.end
//              ^ punctuation.terminator.statement
      active:
//    ^^^^^^ entity.name.label
//          ^ punctuation.separator
            been:-new head;
//          ^^^^ variable
//              ^^ keyword.operator.assignment
//                ^^^ keyword.control.new
//                    ^^^^ entity.name.class
//                        ^ punctuation.terminator.statement
            wait(start.cars);
//          ^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^^^ variable
//                    ^ punctuation.accessor
//                     ^^^^ variable
//                         ^ punctuation.section.parens
//                          ^ punctuation.terminator.statement
            send(suc);
//          ^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^ variable
//                  ^ punctuation.section.parens
//                   ^ punctuation.terminator.statement
            hold(dist);
//          ^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^^ variable
//                   ^ punctuation.section.parens
//                    ^ punctuation.terminator.statement
            if stop then
//          ^^ keyword.control.if
//             ^^^^ variable
//                  ^^^^ keyword.control.then
            begin if nextev==none then activate main after this car;
//          ^^^^^ keyword.control.begin
//                ^^ keyword.control.if
//                   ^^^^^^ variable
//                         ^^ keyword.operator.comparison
//                           ^^^^ constant.language.null
//                                ^^^^ keyword.control.then
//                                     ^^^^^^^^ keyword.control.activate
//                                              ^^^^ variable
//                                                   ^^^^^ keyword.control.after
//                                                         ^^^^ keyword.other.this
//                                                              ^^^ variable
//                                                                 ^ punctuation.terminator.statement
                  goto active;
//                ^^^^ keyword.control.goto
//                     ^^^^^^ entity.name.label
//                           ^ punctuation.terminator.statement
            end ;
//          ^^^ keyword.control.end
//              ^ punctuation.terminator.statement
            if destin.gone then goto active;new townpoint(destin).into(been);
//          ^^ keyword.control.if
//             ^^^^^^ variable
//                   ^ punctuation.accessor
//                    ^^^^ variable
//                         ^^^^ keyword.control.then
//                              ^^^^ keyword.control.goto
//                                   ^^^^^^ entity.name.label
//                                         ^ punctuation.terminator.statement
//                                          ^^^ keyword.control.new
//                                              ^^^^^^^^^ entity.name.class
//                                                       ^ punctuation.section.parens
//                                                        ^^^^^^ variable
//                                                              ^ punctuation.section.parens
//                                                               ^ punctuation.accessor
//                                                                ^^^^ entity.name.function
//                                                                    ^ punctuation.section.parens
//                                                                     ^^^^ variable
//                                                                         ^ punctuation.section.parens
//                                                                          ^ punctuation.terminator.statement
            if destin==destination then
//          ^^ keyword.control.if
//             ^^^^^^ variable
//                   ^^ keyword.operator.comparison
//                     ^^^^^^^^^^^ variable
//                                 ^^^^ keyword.control.then
            begin activate main after this car;
//          ^^^^^ keyword.control.begin
//                ^^^^^^^^ keyword.control.activate
//                         ^^^^ variable
//                              ^^^^^ keyword.control.after
//                                    ^^^^ keyword.other.this
//                                         ^^^ variable
//                                            ^ punctuation.terminator.statement
                  h:-been;
//                ^ variable
//                 ^^ keyword.operator.assignment
//                   ^^^^ variable
//                       ^ punctuation.terminator.statement
                  goto active;
//                ^^^^ keyword.control.goto
//                     ^^^^^^ entity.name.label
//                           ^ punctuation.terminator.statement
            end ;
//          ^^^ keyword.control.end
//              ^ punctuation.terminator.statement
            send(destin.cars.first);
//          ^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^^^^ variable
//                     ^ punctuation.accessor
//                      ^^^^ variable
//                          ^ punctuation.accessor
//                           ^^^^^ variable
//                                ^ punctuation.section.parens
//                                 ^ punctuation.terminator.statement
            destin.gone:=true ;
//          ^^^^^^ variable
//                ^ punctuation.accessor
//                 ^^^^ variable
//                     ^^ keyword.operator.assignment
//                       ^^^^ constant.language.bool
//                            ^ punctuation.terminator.statement
            goto active;
//          ^^^^ keyword.control.goto
//               ^^^^^^ entity.name.label
//                     ^ punctuation.terminator.statement
      end ;
//    ^^^ keyword.control.end
//        ^ punctuation.terminator.statement

      link class townpoint(t);ref (town)t;
//    ^^^^ entity.name.class
//         ^^^^^ keyword.other.class
//               ^^^^^^^^^ entity.name.class
//                        ^ punctuation.section.parens
//                         ^ variable.parameter
//                          ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
//                            ^^^ storage.modifier
//                                ^ punctuation.section.parens
//                                 ^^^^ entity.name.class
//                                     ^ punctuation.section.parens
//                                      ^ variable
//                                       ^ punctuation.terminator.statement
      begin procedure put(h);ref (head)h;
//    ^^^^^ keyword.control.begin
//          ^^^^^^^^^ storage.type
//                    ^^^ entity.name.function
//                       ^ punctuation.section.parens
//                        ^ variable.parameter
//                         ^ punctuation.section.parens
//                          ^ punctuation.terminator.statement

//                                ^^^^ entity.name.class
//                                    ^ punctuation.section.parens
//                                     ^ variable
//                                      ^ punctuation.terminator.statement
            begin new townpoint(t).into(h);
//          ^^^^^ keyword.control.begin
//                ^^^ keyword.control.new
//                    ^^^^^^^^^ entity.name.class
//                             ^ punctuation.section.parens
//                              ^ variable
//                               ^ punctuation.section.parens
//                                ^ punctuation.accessor
//                                 ^^^^ entity.name.function
//                                     ^ punctuation.section.parens
//                                      ^ variable
//                                       ^ punctuation.section.parens
//                                        ^ punctuation.terminator.statement
                  inspect suc when townpoint do put(h);
//                ^^^^^^^ keyword.control.inspect
//                        ^^^ variable
//                            ^^^^ keyword.control.when
//                                 ^^^^^^^^^ entity.name.class
//                                           ^^ keyword.control.do
//                                              ^^^ entity.name.function
//                                                 ^ punctuation.section.parens
//                                                  ^ variable
//                                                   ^ punctuation.section.parens
//                                                    ^ punctuation.terminator.statement
            end ;
//          ^^^ keyword.control.end
//              ^ punctuation.terminator.statement
            procedure write;
//          ^^^^^^^^^ storage.type
//                    ^^^^^ entity.name.function
//                         ^ punctuation.terminator.statement
            if suc is townpoint then
//          ^^ keyword.control.if
//             ^^^ variable
//                 ^^ keyword.other.is
//                    ^^^^^^^^^ variable
//                              ^^^^ keyword.control.then
            begin if sysout.pos gt 100-t.nam_ .length then outimage;
//          ^^^^^ keyword.control.begin
//                ^^ keyword.control.if
//                   ^^^^^^ variable
//                         ^ punctuation.accessor
//                          ^^^ variable
//                              ^^ keyword.operator
//                                 ^^^ constant.numeric.decimal
//                                    ^ keyword.operator.arithmetic
//                                     ^ variable

//                                 ^^^^ variable
//                                      ^ punctuation.terminator.statement
//                                       ^^^^ storage.type
//                                            ^^^^ variable
//                                                 ^ punctuation.terminator.statement
      begin ref (head)cars;
//    ^^^^^ keyword.control.begin
//          ^^^ storage.modifier
//              ^ punctuation.section.parens
//               ^^^^ entity.name.class
//                   ^ punctuation.section.parens
//                    ^^^^ variable
//                        ^ punctuation.terminator.statement
            ref (town)procedure find(code);text code;

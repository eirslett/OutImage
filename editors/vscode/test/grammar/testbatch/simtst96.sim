      if not open(blanks(80)) then begin found_error:=true;
//    ^^ keyword.control.if
//       ^^^ keyword.operator
//           ^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^ entity.name.function
//                      ^ punctuation.section.parens

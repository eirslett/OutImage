//                                                               ^ punctuation.terminator.statement
COMMENT CLASS Person in an out-of-date format ************;
// <----------------------------------------------------------- comment.block
                           VALUE        pname;
//                         ^^^^^ keyword.other.value
//                                      ^^^^^ variable
//                                           ^ punctuation.terminator.statement
                           TEXT         pname;
//                         ^^^^ storage.type
//                                      ^^^^^ variable
//                                           ^ punctuation.terminator.statement
                           INTEGER      yob, yod, children;
//                         ^^^^^^^ storage.type
//                                      ^^^ variable
//                                         ^ punctuation.separator
//                                           ^^^ variable
//                                              ^ punctuation.separator
//                                                ^^^^^^^^ variable
//                                                        ^ punctuation.terminator.statement
                           BOOLEAN      sex;
//                         ^^^^^^^ storage.type
//                                      ^^^ variable
//                                         ^ punctuation.terminator.statement
                           REF (Person) mp, es, yo ,father;
//                         ^^^ storage.modifier
//                             ^ punctuation.section.parens
//                              ^^^^^^ entity.name.class
//                                    ^ punctuation.section.parens
//                                      ^^ variable
//                                        ^ punctuation.separator
//                                          ^^ variable
//                                            ^ punctuation.separator
//                                              ^^ variable
//                                                 ^ punctuation.separator
//                                                  ^^^^^^ variable
//                                                        ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
         REF (Person) PROCEDURE Mother;
//       ^^^ storage.modifier
//           ^ punctuation.section.parens
//            ^^^^^^ entity.name.class
//                  ^ punctuation.section.parens
//                    ^^^^^^^^^ storage.type
//                              ^^^^^^ entity.name.function
//                                    ^ punctuation.terminator.statement
               Mother :- father.mp;
//             ^^^^^^ variable
//                    ^^ keyword.operator.assignment
//                       ^^^^^^ variable
//                             ^ punctuation.accessor
//                              ^^ variable
//                                ^ punctuation.terminator.statement

         INTEGER PROCEDURE Siblings;
//       ^^^^^^^ storage.type
//               ^^^^^^^^^ storage.type
//                         ^^^^^^^^ entity.name.function
//                                 ^ punctuation.terminator.statement
               IF father =/= NONE THEN Siblings := father.children-1;
//             ^^ keyword.control.if
//                ^^^^^^ variable
//                       ^^^ keyword.operator.comparison
//                           ^^^^ constant.language.null
//                                ^^^^ keyword.control.then
//                                     ^^^^^^^^ variable
//                                              ^^ keyword.operator.assignment
//                                                 ^^^^^^ variable
//                                                       ^ punctuation.accessor
//                                                        ^^^^^^^^ variable
//                                                                ^ keyword.operator.arithmetic
//                                                                 ^ constant.numeric.decimal
//                                                                  ^ punctuation.terminator.statement

         INTEGER PROCEDURE Brothers;
//       ^^^^^^^ storage.type
//               ^^^^^^^^^ storage.type
//                         ^^^^^^^^ entity.name.function
//                                 ^ punctuation.terminator.statement
         begin
//       ^^^^^ keyword.control.begin
                REF (Person) p; INTEGER      t;
//              ^^^ storage.modifier
//                  ^ punctuation.section.parens
//                   ^^^^^^ entity.name.class
//                         ^ punctuation.section.parens
//                           ^ variable
//                            ^ punctuation.terminator.statement
//                              ^^^^^^^ storage.type
//                                           ^ variable
//                                            ^ punctuation.terminator.statement
                IF father =/= NONE then begin
//              ^^ keyword.control.if
//                 ^^^^^^ variable
//                        ^^^ keyword.operator.comparison
//                            ^^^^ constant.language.null
//                                 ^^^^ keyword.control.then
//                                      ^^^^^ keyword.control.begin
                   p :- father.yo;
//                 ^ variable
//                   ^^ keyword.operator.assignment
//                      ^^^^^^ variable
//                            ^ punctuation.accessor
//                             ^^ variable
//                               ^ punctuation.terminator.statement
                   WHILE p =/= NONE DO begin
//                 ^^^^^ keyword.control.while
//                       ^ variable
//                         ^^^ keyword.operator.comparison
//                             ^^^^ constant.language.null
//                                  ^^ keyword.control.do
//                                     ^^^^^ keyword.control.begin
                        IF  NOT p.sex OR p == THIS Person  then p:-p.es
//                      ^^ keyword.control.if
//                          ^^^ keyword.operator
//                              ^ variable
//                               ^ punctuation.accessor
//                                ^^^ variable
//                                    ^^ keyword.operator
//                                       ^ variable
//                                         ^^ keyword.operator.comparison
//                                            ^^^^ keyword.other.this
//                                                 ^^^^^^ variable
//                                                         ^^^^ keyword.control.then
//                                                              ^ variable
//                                                               ^^ keyword.operator.assignment
//                                                                 ^ variable
//                                                                  ^ punctuation.accessor
//                                                                   ^^ variable
                        ELSE begin
//                      ^^^^ keyword.control.else
//                           ^^^^^ keyword.control.begin
                            t := t+1;  p :- p.es  end;
//                          ^ variable
//                            ^^ keyword.operator.assignment
//                               ^ variable
//                                ^ keyword.operator.arithmetic
//                                 ^ constant.numeric.decimal
//                                  ^ punctuation.terminator.statement
//                                     ^ variable
//                                       ^^ keyword.operator.assignment
//                                          ^ variable
//                                           ^ punctuation.accessor
//                                            ^^ variable
//                                                ^^^ keyword.control.end
//                                                   ^ punctuation.terminator.statement
                   end;
//                 ^^^ keyword.control.end
//                    ^ punctuation.terminator.statement
                   Brothers := t
//                 ^^^^^^^^ variable
//                          ^^ keyword.operator.assignment
//                             ^ variable
                end
//              ^^^ keyword.control.end
         end of procedure Brothers;
//       ^^^ keyword.control.end
//           ^^^^^^^^^^^^^^^^^^^^^ comment.block
//                                ^ punctuation.terminator.statement

         INTEGER PROCEDURE Sisters;
//       ^^^^^^^ storage.type
//               ^^^^^^^^^ storage.type
//                         ^^^^^^^ entity.name.function
//                                ^ punctuation.terminator.statement
         begin REF (Person) p; INTEGER t;
//       ^^^^^ keyword.control.begin
//             ^^^ storage.modifier
//                 ^ punctuation.section.parens
//                  ^^^^^^ entity.name.class
//                        ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.terminator.statement
//                             ^^^^^^^ storage.type
//                                     ^ variable
//                                      ^ punctuation.terminator.statement
               IF father =/= NONE then begin
//             ^^ keyword.control.if
//                ^^^^^^ variable
//                       ^^^ keyword.operator.comparison
//                           ^^^^ constant.language.null
//                                ^^^^ keyword.control.then
//                                     ^^^^^ keyword.control.begin
                  p :- father.yo;
//                ^ variable
//                  ^^ keyword.operator.assignment
//                     ^^^^^^ variable
//                           ^ punctuation.accessor
//                            ^^ variable
//                              ^ punctuation.terminator.statement
                  WHILE p =/= NONE DO begin
//                ^^^^^ keyword.control.while
//                      ^ variable
//                        ^^^ keyword.operator.comparison
//                            ^^^^ constant.language.null
//                                 ^^ keyword.control.do
//                                    ^^^^^ keyword.control.begin
                     IF p.sex OR p == THIS Person then !nothing;
//                   ^^ keyword.control.if
//                      ^ variable
//                       ^ punctuation.accessor
//                        ^^^ variable
//                            ^^ keyword.operator
//                               ^ variable
//                                 ^^ keyword.operator.comparison
//                                    ^^^^ keyword.other.this
//                                         ^^^^^^ variable
//                                                ^^^^ keyword.control.then
//                                                     ^^^^^^^^^ comment.block
                     ELSE  t := t+1;
//                   ^^^^ keyword.control.else
//                         ^ variable
//                           ^^ keyword.operator.assignment
//                              ^ variable
//                               ^ keyword.operator.arithmetic
//                                ^ constant.numeric.decimal
//                                 ^ punctuation.terminator.statement
                     p:-p.es;
//                   ^ variable
//                    ^^ keyword.operator.assignment
//                      ^ variable
//                       ^ punctuation.accessor
//                        ^^ variable
//                          ^ punctuation.terminator.statement
                  end
//                ^^^ keyword.control.end
               end;
//             ^^^ keyword.control.end
//                ^ punctuation.terminator.statement
               Sisters := t
//             ^^^^^^^ variable
//                     ^^ keyword.operator.assignment
//                        ^ variable
         end of procedure Sisters;
//       ^^^ keyword.control.end
//           ^^^^^^^^^^^^^^^^^^^^ comment.block
//                               ^ punctuation.terminator.statement

         INTEGER PROCEDURE Age;
//       ^^^^^^^ storage.type
//               ^^^^^^^^^ storage.type
//                         ^^^ entity.name.function
//                            ^ punctuation.terminator.statement
               Age :=  (IF yod=0 THEN 1983 ELSE yod) -yob;
//             ^^^ variable
//                 ^^ keyword.operator.assignment
//                     ^ punctuation.section.parens
//                      ^^ keyword.control.if
//                         ^^^ variable
//                            ^ keyword.operator.comparison
//                             ^ constant.numeric.decimal
//                               ^^^^ keyword.control.then
//                                    ^^^^ constant.numeric.decimal
//                                         ^^^^ keyword.control.else
//                                              ^^^ variable
//                                                 ^ punctuation.section.parens
//                                                   ^ keyword.operator.arithmetic
//                                                    ^^^ variable
//                                                       ^ punctuation.terminator.statement

         REF (Person) PROCEDURE Lastaddition;
//       ^^^ storage.modifier
//           ^ punctuation.section.parens
//            ^^^^^^ entity.name.class
//                  ^ punctuation.section.parens
//                    ^^^^^^^^^ storage.type
//                              ^^^^^^^^^^^^ entity.name.function
//                                          ^ punctuation.terminator.statement
               Lastaddition :- yo;
//             ^^^^^^^^^^^^ variable
//                          ^^ keyword.operator.assignment
//                             ^^ variable
//                               ^ punctuation.terminator.statement

         REF (Person) PROCEDURE Firstborn;
//       ^^^ storage.modifier
//           ^ punctuation.section.parens
//            ^^^^^^ entity.name.class
//                  ^ punctuation.section.parens
//                    ^^^^^^^^^ storage.type
//                              ^^^^^^^^^ entity.name.function
//                                       ^ punctuation.terminator.statement
         begin REF (Person) p;
//       ^^^^^ keyword.control.begin
//             ^^^ storage.modifier
//                 ^ punctuation.section.parens
//                  ^^^^^^ entity.name.class
//                        ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.terminator.statement
               p :- yo;
//             ^ variable
//               ^^ keyword.operator.assignment
//                  ^^ variable
//                    ^ punctuation.terminator.statement
               IF p =/= NONE then WHILE p.es =/= NONE DO p :- p.es;
//             ^^ keyword.control.if
//                ^ variable
//                  ^^^ keyword.operator.comparison
//                      ^^^^ constant.language.null
//                           ^^^^ keyword.control.then
//                                ^^^^^ keyword.control.while
//                                      ^ variable
//                                       ^ punctuation.accessor
//                                        ^^ variable
//                                           ^^^ keyword.operator.comparison
//                                               ^^^^ constant.language.null
//                                                    ^^ keyword.control.do
//                                                       ^ variable
//                                                         ^^ keyword.operator.assignment
//                                                            ^ variable
//                                                             ^ punctuation.accessor
//                                                              ^^ variable
//                                                                ^ punctuation.terminator.statement
               Firstborn :- p
//             ^^^^^^^^^ variable
//                       ^^ keyword.operator.assignment
//                          ^ variable
         end of procedure Firstborn;
//       ^^^ keyword.control.end
//           ^^^^^^^^^^^^^^^^^^^^^^ comment.block
//                                 ^ punctuation.terminator.statement

         OUTIMAGE;
//       ^^^^^^^^ variable
//               ^ punctuation.terminator.statement
         OUTTEXT (pname); OUTTEXT (" was born in"); OUTINT (yob, 5);
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^ variable
//                     ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
//                        ^^^^^^^ entity.name.function

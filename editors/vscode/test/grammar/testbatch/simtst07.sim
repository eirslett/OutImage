   procedure Testsqrt (x) ;  real  x ;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^ variable.parameter
//                      ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
//                           ^^^^ storage.type
//                                 ^ variable
//                                   ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      real     a ;
//    ^^^^ storage.type
//             ^ variable
//               ^ punctuation.terminator.statement
      a :=  SQRT (x)**2 ;
//    ^ variable
//      ^^ keyword.operator.assignment
//          ^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.section.parens
//                  ^^ keyword.operator.arithmetic
//                    ^ constant.numeric.decimal
//                      ^ punctuation.terminator.statement

      IF Realdiff (a, x)
//    ^^ keyword.control.if
//       ^^^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.separator
//                    ^ variable
//                     ^ punctuation.section.parens
      THEN
//    ^^^^ keyword.control.then
         begin
//       ^^^^^ keyword.control.begin
         Error ("sqrt") ;
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^^^^^^ string.quoted.double
//                    ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
         outtext ("   x=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^ string.quoted.double
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
         outreal (x, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outtext (" SQRT (x)**2=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^ string.quoted.double
//                               ^ punctuation.section.parens
//                                 ^ punctuation.terminator.statement
         outreal (a, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         outimage
//       ^^^^^^^^ variable
         END
//       ^^^ keyword.control.end

      END of procedure Testsqrt ;
//    ^^^ keyword.control.end
//        ^^^^^^^^^^^^^^^^^^^^^ comment.block
//                              ^ punctuation.terminator.statement

   procedure Testln (x, y) ;  real  x, y ;
// ^^^^^^^^^ storage.type
//           ^^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable.parameter
//                    ^ punctuation.separator
//                      ^ variable.parameter
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
//                            ^^^^ storage.type
//                                  ^ variable
//                                   ^ punctuation.separator
//                                     ^ variable
//                                       ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      real    a, b ;
//    ^^^^ storage.type
//            ^ variable
//             ^ punctuation.separator
//               ^ variable
//                 ^ punctuation.terminator.statement
      a := LN (x*y) ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ keyword.operator.arithmetic
//               ^ variable
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      b := LN (x)+LN (y) ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.section.parens

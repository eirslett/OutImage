// SYNTAX TEST "source.simula" "simtst07"
% ==========================================   Main   program   ================
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:  Simula a.s. - SIMULA TEST NO 7
// <------------------------------------------------ comment.directive
%
// <- comment.directive
%  PURPOSE :  To test the mathematical library (x**y, Sqrt, Ln, Exp, Sin, Cos
// <----------------------------------------------------------------------------- comment.directive
%             and ArcTan) on variables of type real.
// <---------------------------------------------------- comment.directive
%
// <- comment.directive
%  METHOD :   Compare the results obtained by using the functions in different
// <------------------------------------------------------------------------------ comment.directive
%             ways, which should give the same answer.  If the difference is
// <---------------------------------------------------------------------------- comment.directive
%             unacceptable, an error-message is given.
// <------------------------------------------------------ comment.directive
%
// <- comment.directive
%  NOTE:  1 - At line marked with NOTE 1, the lowest acceptable difference
// <-------------------------------------------------------------------------- comment.directive
%             between the answers should be filled in.
// <------------------------------------------------------ comment.directive
%
// <- comment.directive
%  COMMENTED BY:  BEH  08/07-86
// <------------------------------- comment.directive
%  pje 24/8 87: changed NOTE 1 from 1&-11 (absurd for reals!!) to 5&-7
// <---------------------------------------------------------------------- comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
begin
// <----- keyword.control.begin
class Testmatlib ;
// <----- keyword.other.class
//    ^^^^^^^^^^ entity.name.class
//               ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin

   Boolean  found_error;
// ^^^^^^^ storage.type
//          ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   procedure Error (t) ;  value t ;  text t ;
// ^^^^^^^^^ storage.type
//           ^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^ variable.parameter
//                   ^ punctuation.section.parens
//                     ^ punctuation.terminator.statement
//                        ^^^^^ keyword.other.value
//                              ^ variable
//                                ^ punctuation.terminator.statement
//                                   ^^^^ storage.type
//                                        ^ variable
//                                          ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      outtext ("*** Error in the ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                ^ punctuation.section.parens
//                                  ^ punctuation.terminator.statement
      outtext (t) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.section.parens
//                ^ punctuation.terminator.statement
      outtext (" routine") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^ string.quoted.double
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
      outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
      END of procedure Error ;
//    ^^^ keyword.control.end
//        ^^^^^^^^^^^^^^^^^^ comment.block
//                           ^ punctuation.terminator.statement

   Boolean procedure Realdiff (x, y) ;  real x, y ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^ storage.type
//                   ^^^^^^^^ entity.name.function
//                            ^ punctuation.section.parens
//                             ^ variable.parameter
//                              ^ punctuation.separator
//                                ^ variable.parameter
//                                 ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                      ^^^^ storage.type
//                                           ^ variable
//                                            ^ punctuation.separator
//                                              ^ variable
//                                                ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      real     diff ;
//    ^^^^ storage.type
//             ^^^^ variable
//                  ^ punctuation.terminator.statement
      diff := ABS (IF  x = 0  THEN  x - y  ELSE  (x - y)/x) ;
//    ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^ keyword.control.if
//                     ^ variable
//                       ^ keyword.operator.comparison
//                         ^ constant.numeric.decimal
//                            ^^^^ keyword.control.then
//                                  ^ variable
//                                    ^ keyword.operator.arithmetic
//                                      ^ variable
//                                         ^^^^ keyword.control.else
//                                               ^ punctuation.section.parens
//                                                ^ variable
//                                                  ^ keyword.operator.arithmetic
//                                                    ^ variable
//                                                     ^ punctuation.section.parens
//                                                      ^ keyword.operator.arithmetic
//                                                       ^ variable
//                                                        ^ punctuation.section.parens
//                                                          ^ punctuation.terminator.statement

      IF  diff > 5.0&-05   THEN                    !***** NOTE 1 *****;
//    ^^ keyword.control.if
//        ^^^^ variable
//             ^ keyword.operator.comparison
//               ^^^^^^^ constant.numeric.decimal
//                         ^^^^ keyword.control.then
//                                                 ^^^^^^^^^^^^^^^^^^^^ comment.block
         begin
//       ^^^^^ keyword.control.begin
         outtext ("*** rel. Error =") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                  ^ punctuation.section.parens
//                                    ^ punctuation.terminator.statement
         outreal (diff, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^ variable
//                    ^ punctuation.separator
//                      ^^ constant.numeric.decimal
//                        ^ punctuation.separator
//                          ^^ constant.numeric.decimal
//                            ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         Realdiff := TRUE
//       ^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
         END
//       ^^^ keyword.control.end

   END of procedure Realdiff ;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^^^^^^^^^^ comment.block
//                           ^ punctuation.terminator.statement


   real procedure Rpower (x, y) ;  real x, y ;
// ^^^^ storage.type
//      ^^^^^^^^^ storage.type
//                ^^^^^^ entity.name.function
//                       ^ punctuation.section.parens
//                        ^ variable.parameter
//                         ^ punctuation.separator
//                           ^ variable.parameter
//                            ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
//                                 ^^^^ storage.type
//                                      ^ variable
//                                       ^ punctuation.separator
//                                         ^ variable
//                                           ^ punctuation.terminator.statement
      Rpower := EXP (y*ln (x)) ;
//    ^^^^^^ variable
//           ^^ keyword.operator.assignment
//              ^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                    ^ keyword.operator.arithmetic
//                     ^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^ variable
//                          ^^ punctuation.section.parens
//                             ^ punctuation.terminator.statement


   real procedure Ipower (b, j) ;  real b ;  INTEGER j ;
// ^^^^ storage.type
//      ^^^^^^^^^ storage.type
//                ^^^^^^ entity.name.function
//                       ^ punctuation.section.parens
//                        ^ variable.parameter
//                         ^ punctuation.separator
//                           ^ variable.parameter
//                            ^ punctuation.section.parens
//                              ^ punctuation.terminator.statement
//                                 ^^^^ storage.type
//                                      ^ variable
//                                        ^ punctuation.terminator.statement
//                                           ^^^^^^^ storage.type
//                                                   ^ variable
//                                                     ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      INTEGER  exp ;
//    ^^^^^^^ storage.type
//             ^^^ variable
//                 ^ punctuation.terminator.statement
      real     prod, base ;
//    ^^^^ storage.type
//             ^^^^ variable
//                 ^ punctuation.separator
//                   ^^^^ variable
//                        ^ punctuation.terminator.statement

      Boolean procedure Bit0 (n) ;  INTEGER  n ;
//    ^^^^^^^ storage.type
//            ^^^^^^^^^ storage.type
//                      ^^^^ entity.name.function
//                           ^ punctuation.section.parens
//                            ^ variable.parameter
//                             ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
//                                  ^^^^^^^ storage.type
//                                           ^ variable
//                                             ^ punctuation.terminator.statement
         Bit0 := (n//2)*2 < n ;
//       ^^^^ variable
//            ^^ keyword.operator.assignment
//               ^ punctuation.section.parens
//                ^ variable
//                 ^^ keyword.operator.arithmetic
//                   ^ constant.numeric.decimal
//                    ^ punctuation.section.parens
//                     ^ keyword.operator.arithmetic
//                      ^ constant.numeric.decimal
//                        ^ keyword.operator.comparison
//                          ^ variable
//                            ^ punctuation.terminator.statement

      base := b ;
//    ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//              ^ punctuation.terminator.statement
      exp :=  ABS (j) ;
//    ^^^ variable
//        ^^ keyword.operator.assignment
//            ^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.section.parens
//                    ^ punctuation.terminator.statement
      prod := IF Bit0 (exp) THEN base ELSE 1.0 ;
//    ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^^ keyword.control.if
//               ^^^^ entity.name.function
//                    ^ punctuation.section.parens
//                     ^^^ variable
//                        ^ punctuation.section.parens
//                          ^^^^ keyword.control.then
//                               ^^^^ variable
//                                    ^^^^ keyword.control.else
//                                         ^^^ constant.numeric.decimal
//                                             ^ punctuation.terminator.statement

      WHILE  exp > 1  DO
//    ^^^^^ keyword.control.while
//           ^^^ variable
//               ^ keyword.operator.comparison
//                 ^ constant.numeric.decimal
//                    ^^ keyword.control.do
         begin
//       ^^^^^ keyword.control.begin
         base := base*base ;
//       ^^^^ variable
//            ^^ keyword.operator.assignment
//               ^^^^ variable
//                   ^ keyword.operator.arithmetic
//                    ^^^^ variable
//                         ^ punctuation.terminator.statement
         exp := exp//2 ;
//       ^^^ variable
//           ^^ keyword.operator.assignment
//              ^^^ variable
//                 ^^ keyword.operator.arithmetic
//                   ^ constant.numeric.decimal
//                     ^ punctuation.terminator.statement
         IF Bit0 (exp) THEN prod := prod*base
//       ^^ keyword.control.if
//          ^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^ variable
//                   ^ punctuation.section.parens
//                     ^^^^ keyword.control.then
//                          ^^^^ variable
//                               ^^ keyword.operator.assignment
//                                  ^^^^ variable
//                                      ^ keyword.operator.arithmetic
//                                       ^^^^ variable
         END ;
//       ^^^ keyword.control.end
//           ^ punctuation.terminator.statement

      Ipower := IF j>0 THEN prod ELSE 1.0/prod
//    ^^^^^^ variable
//           ^^ keyword.operator.assignment
//              ^^ keyword.control.if
//                 ^ variable
//                  ^ keyword.operator.comparison
//                   ^ constant.numeric.decimal
//                     ^^^^ keyword.control.then
//                          ^^^^ variable
//                               ^^^^ keyword.control.else
//                                    ^^^ constant.numeric.decimal
//                                       ^ keyword.operator.arithmetic
//                                        ^^^^ variable
      END of procedure Ipower ;
//    ^^^ keyword.control.end
//        ^^^^^^^^^^^^^^^^^^^ comment.block
//                            ^ punctuation.terminator.statement

   procedure Testrpower (b, e) ;  Real b, e ;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable.parameter
//                        ^ punctuation.separator
//                          ^ variable.parameter
//                           ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                                ^^^^ storage.type
//                                     ^ variable
//                                      ^ punctuation.separator
//                                        ^ variable
//                                          ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      real     x, y, z, r ;
//    ^^^^ storage.type
//             ^ variable
//              ^ punctuation.separator
//                ^ variable
//                 ^ punctuation.separator
//                   ^ variable
//                    ^ punctuation.separator
//                      ^ variable
//                        ^ punctuation.terminator.statement
      r := b ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//           ^ punctuation.terminator.statement
      x := Rpower (b, e) ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.separator
//                    ^ variable
//                     ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
      y := b**e ; z := r**e ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//          ^^ keyword.operator.arithmetic
//            ^ variable
//              ^ punctuation.terminator.statement
//                ^ variable
//                  ^^ keyword.operator.assignment
//                     ^ variable
//                      ^^ keyword.operator.arithmetic
//                        ^ variable
//                          ^ punctuation.terminator.statement

      IF Realdiff (x, y) or Realdiff (y, z)
//    ^^ keyword.control.if
//       ^^^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.separator
//                    ^ variable
//                     ^ punctuation.section.parens
//                       ^^ keyword.operator
//                          ^^^^^^^^ entity.name.function
//                                   ^ punctuation.section.parens
//                                    ^ variable
//                                     ^ punctuation.separator
//                                       ^ variable
//                                        ^ punctuation.section.parens
      THEN
//    ^^^^ keyword.control.then
         begin
//       ^^^^^ keyword.control.begin
         Error ("Rpower") ;
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^^^^^^^^ string.quoted.double
//                      ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
         outtext ("  base=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^ string.quoted.double
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outreal (r, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outtext ("  exp=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^ string.quoted.double
//                        ^ punctuation.section.parens
//                          ^ punctuation.terminator.statement
         outreal (e, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         outtext ("  base**exp=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^ string.quoted.double
//                              ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
         outreal (x, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outreal (y, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outreal (z, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         outimage
//       ^^^^^^^^ variable
         END
//       ^^^ keyword.control.end

      END of procedure Testrpower ;
//    ^^^ keyword.control.end
//        ^^^^^^^^^^^^^^^^^^^^^^^ comment.block
//                                ^ punctuation.terminator.statement

   procedure Testipower (b, e) ;  INTEGER  b, e ;
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable.parameter
//                        ^ punctuation.separator
//                          ^ variable.parameter
//                           ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                                ^^^^^^^ storage.type
//                                         ^ variable
//                                          ^ punctuation.separator
//                                            ^ variable
//                                              ^ punctuation.terminator.statement
      begin
//    ^^^^^ keyword.control.begin
      real    x, y, z, r ;
//    ^^^^ storage.type
//            ^ variable
//             ^ punctuation.separator
//               ^ variable
//                ^ punctuation.separator
//                  ^ variable
//                   ^ punctuation.separator
//                     ^ variable
//                       ^ punctuation.terminator.statement
      r := b ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//           ^ punctuation.terminator.statement
      x := Ipower (b, e) ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.separator
//                    ^ variable
//                     ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
      y := b**e ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//          ^^ keyword.operator.arithmetic
//            ^ variable
//              ^ punctuation.terminator.statement
      z := r**e ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//          ^^ keyword.operator.arithmetic
//            ^ variable
//              ^ punctuation.terminator.statement

      IF Realdiff (x, y) or Realdiff (y, z)
//    ^^ keyword.control.if
//       ^^^^^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^ variable
//                  ^ punctuation.separator
//                    ^ variable
//                     ^ punctuation.section.parens
//                       ^^ keyword.operator
//                          ^^^^^^^^ entity.name.function
//                                   ^ punctuation.section.parens
//                                    ^ variable
//                                     ^ punctuation.separator
//                                       ^ variable
//                                        ^ punctuation.section.parens
      THEN
//    ^^^^ keyword.control.then
         begin
//       ^^^^^ keyword.control.begin
         Error ("Ipower") ;
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^^^^^^^^ string.quoted.double
//                      ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
         outtext ("  base=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^ string.quoted.double
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outreal (r, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outtext ("  exp=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^ string.quoted.double
//                        ^ punctuation.section.parens
//                          ^ punctuation.terminator.statement
         outreal (e, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         outtext ("  base**exp=") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^ string.quoted.double
//                              ^ punctuation.section.parens
//                                ^ punctuation.terminator.statement
         outreal (x, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outreal (y, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^ variable
//                 ^ punctuation.separator
//                   ^^ constant.numeric.decimal
//                     ^ punctuation.separator
//                       ^^ constant.numeric.decimal
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
         outreal (z, 15, 22) ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens

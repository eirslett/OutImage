// SYNTAX TEST "source.simula" "simtst44"
% ===============================================   Main   program =============
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 44
// <-------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     Test text procedure.
// <------------------------------------ comment.directive
%
// <- comment.directive
%  REWRITTEN BY:  BEH   24/07-86
// <-------------------------------- comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   Boolean found_error ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   TEXT               t1, t2 ;
// ^^^^ storage.type
//                    ^^ variable
//                      ^ punctuation.separator
//                        ^^ variable
//                           ^ punctuation.terminator.statement

   TEXT PROCEDURE Mysub (t, i1, i2) ;
// ^^^^ storage.type
//      ^^^^^^^^^ storage.type
//                ^^^^^ entity.name.function
//                      ^ punctuation.section.parens
//                       ^ variable.parameter
//                        ^ punctuation.separator
//                          ^^ variable.parameter
//                            ^ punctuation.separator
//                              ^^ variable.parameter
//                                ^ punctuation.section.parens
//                                  ^ punctuation.terminator.statement
                         VALUE    t ;
//                       ^^^^^ keyword.other.value
//                                ^ variable
//                                  ^ punctuation.terminator.statement
                         TEXT     t ;
//                       ^^^^ storage.type
//                                ^ variable
//                                  ^ punctuation.terminator.statement
                         INTEGER  i1, i2 ;
//                       ^^^^^^^ storage.type
//                                ^^ variable
//                                  ^ punctuation.separator
//                                    ^^ variable
//                                       ^ punctuation.terminator.statement
   IF  i2 < i1 OR t.length < i2
// ^^ keyword.control.if
//     ^^ variable
//        ^ keyword.operator.comparison
//          ^^ variable
//             ^^ keyword.operator
//                ^ variable
//                 ^ punctuation.accessor
//                  ^^^^^^ variable
//                         ^ keyword.operator.comparison
//                           ^^ variable
   THEN
// ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   BEGIN
// ^^^^^ keyword.control.begin
      TEXT         th ;
//    ^^^^ storage.type
//                 ^^ variable
//                    ^ punctuation.terminator.statement
      INTEGER      j ;
//    ^^^^^^^ storage.type
//                 ^ variable
//                   ^ punctuation.terminator.statement
      th :- BLANKS (i2 - i1 + 1) ;
//    ^^ variable
//       ^^ keyword.operator.assignment
//          ^^^^^^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^^ variable
//                     ^ keyword.operator.arithmetic
//                       ^^ variable
//                          ^ keyword.operator.arithmetic
//                            ^ constant.numeric.decimal
//                             ^ punctuation.section.parens
//                               ^ punctuation.terminator.statement
      t.SETPOS (i1) ;
//    ^ variable
//     ^ punctuation.accessor
//      ^^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^^ variable
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      FOR  j := i1  STEP 1 UNTIL i2 DO  th.PUTCHAR (t.GETCHAR) ;
//    ^^^ keyword.control.for
//         ^ variable
//           ^^ keyword.operator.assignment
//              ^^ variable
//                  ^^^^ keyword.control.step
//                       ^ constant.numeric.decimal
//                         ^^^^^ keyword.control.until
//                               ^^ variable
//                                  ^^ keyword.control.do
//                                      ^^ variable
//                                        ^ punctuation.accessor
//                                         ^^^^^^^ entity.name.function
//                                                 ^ punctuation.section.parens
//                                                  ^ variable
//                                                   ^ punctuation.accessor
//                                                    ^^^^^^^ variable
//                                                           ^ punctuation.section.parens
//                                                             ^ punctuation.terminator.statement
      Mysub :- th
//    ^^^^^ variable
//          ^^ keyword.operator.assignment
//             ^^ variable
   END of procedure Mysub ;
// ^^^ keyword.control.end
//     ^^^^^^^^^^^^^^^^^^ comment.block
//                        ^ punctuation.terminator.statement

   Outtext ("--- START Simula a.s. TEST 44") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^ punctuation.terminator.statement
   Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
   Outtext ("--- Simple test of text procedures.") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
   Outimage ; Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
//            ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   t1 :- COPY ("test one") ;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^ string.quoted.double
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
   t2 :- Mysub (t1, 6, 8) ;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^^ variable
//                ^ punctuation.separator
//                  ^ constant.numeric.decimal
//                   ^ punctuation.separator
//                     ^ constant.numeric.decimal
//                      ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
   t1 :- t1.sub (6, 3) ;
// ^^ variable
//    ^^ keyword.operator.assignment
//       ^^ variable
//         ^ punctuation.accessor
//          ^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^ constant.numeric.decimal
//                ^ punctuation.separator
//                  ^ constant.numeric.decimal
//                   ^ punctuation.section.parens
//                     ^ punctuation.terminator.statement
   IF  t1 = t2  THEN
// ^^ keyword.control.if
//     ^^ variable
//        ^ keyword.operator.comparison
//          ^^ variable
//              ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Text values.") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Erroneus values :") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                            ^ punctuation.section.parens
//                                              ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("              t1 == t2  -  ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                          ^ punctuation.section.parens
//                                            ^ punctuation.terminator.statement
      Outtext (if t1 == t2 then "true" else "false") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ keyword.control.if
//                ^^ variable
//                   ^^ keyword.operator.comparison
//                      ^^ variable
//                         ^^^^ keyword.control.then
//                              ^^^^^^ string.quoted.double
//                                     ^^^^ keyword.control.else
//                                          ^^^^^^^ string.quoted.double
//                                                 ^ punctuation.section.parens
//                                                   ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("              t1 == ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                   ^ punctuation.section.parens
//                                     ^ punctuation.terminator.statement
      Outtext (if t1 == notext then "notext" else t1) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ keyword.control.if
//                ^^ variable
//                   ^^ keyword.operator.comparison
//                      ^^^^^^ constant.language.null
//                             ^^^^ keyword.control.then
//                                  ^^^^^^^^ string.quoted.double
//                                           ^^^^ keyword.control.else
//                                                ^^ variable
//                                                  ^ punctuation.section.parens
//                                                    ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("              t2 == ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                   ^ punctuation.section.parens
//                                     ^ punctuation.terminator.statement
      Outtext (if t2 == notext then "notext" else t2) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ keyword.control.if
//                ^^ variable
//                   ^^ keyword.operator.comparison
//                      ^^^^^^ constant.language.null
//                             ^^^^ keyword.control.then
//                                  ^^^^^^^^ string.quoted.double
//                                           ^^^^ keyword.control.else
//                                                ^^ variable
//                                                  ^ punctuation.section.parens
//                                                    ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("              t1.main == ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outtext (if t1.main == notext then "notext" else t1.main) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ keyword.control.if
//                ^^ variable
//                  ^ punctuation.accessor
//                   ^^^^ variable
//                        ^^ keyword.operator.comparison
//                           ^^^^^^ constant.language.null
//                                  ^^^^ keyword.control.then
//                                       ^^^^^^^^ string.quoted.double
//                                                ^^^^ keyword.control.else
//                                                     ^^ variable
//                                                       ^ punctuation.accessor
//                                                        ^^^^ variable
//                                                            ^ punctuation.section.parens
//                                                              ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("              t2.main == ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outtext (if t2.main == notext then "notext" else t2.main) ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^ keyword.control.if
//                ^^ variable
//                  ^ punctuation.accessor
//                   ^^^^ variable
//                        ^^ keyword.operator.comparison
//                           ^^^^^^ constant.language.null
//                                  ^^^^ keyword.control.then
//                                       ^^^^^^^^ string.quoted.double
//                                                ^^^^ keyword.control.else
//                                                     ^^ variable
//                                                       ^ punctuation.accessor
//                                                        ^^^^ variable
//                                                            ^ punctuation.section.parens
//                                                              ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   IF found_error THEN
// ^^ keyword.control.if
//    ^^^^^^^^^^^ variable
//                ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   BEGIN
// ^^^^^ keyword.control.begin
      Outtext ("--- NO ERRORS FOUND IN THIS TEST") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
      Outimage
//    ^^^^^^^^ variable
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 44") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
END of program
// <--- keyword.control.end
//  ^^^^^^^^^^ comment.block
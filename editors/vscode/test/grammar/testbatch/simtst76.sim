//                        ^ punctuation.section.parens
//                         ^^^ string.quoted.double
//                            ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
               End;
//             ^^^ keyword.control.end
//                ^ punctuation.terminator.statement
               Print("G");
//             ^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ string.quoted.double
//                      ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
         End;
//       ^^^ keyword.control.end
//          ^ punctuation.terminator.statement

         Print("AA");
//       ^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^ string.quoted.double
//                 ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
         x:- New A ;
//       ^ variable
//        ^^ keyword.operator.assignment
//           ^^^ keyword.control.new
//               ^ entity.name.class
//                 ^ punctuation.terminator.statement
         Print("AB");
//       ^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^ string.quoted.double
//                 ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement

         t:- Copy (sysout.image.strip);
//       ^ variable
//        ^^ keyword.operator.assignment
//           ^^^^ entity.name.function
//                ^ punctuation.section.parens
//                 ^^^^^^ variable
//                       ^ punctuation.accessor
//                        ^^^^^ variable
//                             ^ punctuation.accessor
//                              ^^^^^ variable
//                                   ^ punctuation.section.parens
//                                    ^ punctuation.terminator.statement
         sysout.setpos (1);
//       ^^^^^^ variable
//             ^ punctuation.accessor
//              ^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ constant.numeric.decimal
//                       ^ punctuation.section.parens
//                        ^ punctuation.terminator.statement
         sysout.image:= notext;
//       ^^^^^^ variable
//             ^ punctuation.accessor
//              ^^^^^ variable
//                   ^^ keyword.operator.assignment
//                      ^^^^^^ constant.language.null
//                            ^ punctuation.terminator.statement

         if t = "AAABCDEFGAB" then
//       ^^ keyword.control.if
//          ^ variable
//            ^ keyword.operator.comparison
//              ^^^^^^^^^^^^^ string.quoted.double
//                            ^^^^ keyword.control.then
         else
//       ^^^^ keyword.control.else
         begin Outtext ("*** ERROR : Detach - resume (1).") ;
//       ^^^^^ keyword.control.begin
//             ^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                        ^ punctuation.section.parens
//                                                          ^ punctuation.terminator.statement
               Outimage ;
//             ^^^^^^^^ variable
//                      ^ punctuation.terminator.statement
               Outtext ("             Erroneus sequencing: ") ;
//             ^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                          ^ punctuation.section.parens
//                                                            ^ punctuation.terminator.statement
               Outtext (t) ;
//             ^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ variable
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
               Outimage; Outimage;
//             ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement
//                       ^^^^^^^^ variable
//                               ^ punctuation.terminator.statement
               found_error := true
//             ^^^^^^^^^^^ variable
//                         ^^ keyword.operator.assignment
//                            ^^^^ constant.language.bool
         end;
//       ^^^ keyword.control.end
//          ^ punctuation.terminator.statement
  End;
//^^^ keyword.control.end
//   ^ punctuation.terminator.statement

SIMSET Begin
// <------ entity.name.class
//     ^^^^^ keyword.control.begin
         Ref(A)x;
//       ^^^ storage.modifier
//          ^ punctuation.section.parens
//           ^ entity.name.class
//            ^ punctuation.section.parens
//             ^ variable
//              ^ punctuation.terminator.statement

         Link Class A;

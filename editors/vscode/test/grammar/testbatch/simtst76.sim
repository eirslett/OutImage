SIMSET Begin
// <------ entity.name.class
//     ^^^^^ keyword.control.begin
         Ref(A) x;
//       ^^^ storage.modifier
//          ^ punctuation.section.parens
//           ^ entity.name.class
//            ^ punctuation.section.parens
//              ^ variable
//               ^ punctuation.terminator.statement

         Link Class A;
//       ^^^^ entity.name.class
//            ^^^^^ keyword.other.class
//                  ^ entity.name.class
//                   ^ punctuation.terminator.statement
         Begin Print("A");
//       ^^^^^ keyword.control.begin
//             ^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ string.quoted.double
//                      ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
               Begin Ref(C) Y;
//             ^^^^^ keyword.control.begin
//                   ^^^ storage.modifier
//                      ^ punctuation.section.parens
//                       ^ entity.name.class
//                        ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.terminator.statement
                     Class C;
//                   ^^^^^ keyword.other.class
//                         ^ entity.name.class
//                          ^ punctuation.terminator.statement
                     Begin Print("C"); Detach;
//                   ^^^^^ keyword.control.begin
//                         ^^^^^ entity.name.function
//                              ^ punctuation.section.parens
//                               ^^^ string.quoted.double
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                     ^^^^^^ variable
//                                           ^ punctuation.terminator.statement
                           Print("E");

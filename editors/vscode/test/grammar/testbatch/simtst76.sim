//                   ^^^ storage.modifier
//                      ^ punctuation.section.parens
//                       ^ entity.name.class
//                        ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.terminator.statement

                     Class C;
//                   ^^^^^ keyword.other.class
//                         ^ entity.name.class
//                          ^ punctuation.terminator.statement
                     Begin Print("D"); Detach;
//                   ^^^^^ keyword.control.begin
//                         ^^^^^ entity.name.function
//                              ^ punctuation.section.parens
//                               ^^^ string.quoted.double
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                     ^^^^^^ variable
//                                           ^ punctuation.terminator.statement
                           Print("F"); This A.Detach;
//                         ^^^^^ entity.name.function
//                              ^ punctuation.section.parens
//                               ^^^ string.quoted.double
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
//                                     ^^^^ keyword.other.this
//                                          ^ variable

//                              ^ punctuation.section.parens
//                               ^^^ string.quoted.double
//                                  ^ punctuation.section.parens
//                                   ^ punctuation.terminator.statement
                     End;
//                   ^^^ keyword.control.end
//                      ^ punctuation.terminator.statement

                     Print("C"); Y:- New C;
//                   ^^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^^^ string.quoted.double
//                            ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                               ^ variable
//                                ^^ keyword.operator.assignment
//                                   ^^^ keyword.control.new
//                                       ^ entity.name.class
//                                        ^ punctuation.terminator.statement
                     Print("E"); Resume(Y);
//                   ^^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^^^ string.quoted.double
//                            ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                               ^^^^^^ entity.name.function
//                                     ^ punctuation.section.parens
//                                      ^ variable
//                                       ^ punctuation.section.parens
//                                        ^ punctuation.terminator.statement
                     Print("I"); Resume(Y);
//                   ^^^^^ entity.name.function
//                        ^ punctuation.section.parens
//                         ^^^ string.quoted.double
//                            ^ punctuation.section.parens
//                             ^ punctuation.terminator.statement
//                               ^^^^^^ entity.name.function
//                                     ^ punctuation.section.parens
//                                      ^ variable
//                                       ^ punctuation.section.parens
//                                        ^ punctuation.terminator.statement
                     Detach
//                   ^^^^^^ variable
               End;
//             ^^^ keyword.control.end
//                ^ punctuation.terminator.statement
               Print("L");
//             ^^^^^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^^^ string.quoted.double
//                      ^ punctuation.section.parens
//                       ^ punctuation.terminator.statement
          End;
//        ^^^ keyword.control.end
//           ^ punctuation.terminator.statement

          x:- New A;
//        ^ variable
//         ^^ keyword.operator.assignment
//            ^^^ keyword.control.new
//                ^ entity.name.class
//                 ^ punctuation.terminator.statement
          Print("B"); Resume(x);
//        ^^^^^ entity.name.function
//             ^ punctuation.section.parens
//              ^^^ string.quoted.double
//                 ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
//                    ^^^^^^ entity.name.function
//                          ^ punctuation.section.parens
//                           ^ variable

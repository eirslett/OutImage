   procedure testvalue (bt, ct, jt, rt, tt, rat, rbt,
// ^^^^^^^^^ storage.type
//           ^^^^^^^^^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^^ variable.parameter
//                        ^ punctuation.separator
//                          ^^ variable.parameter
//                            ^ punctuation.separator
//                              ^^ variable.parameter
//                                ^ punctuation.separator
//                                  ^^ variable.parameter
//                                    ^ punctuation.separator
//                                      ^^ variable.parameter
//                                        ^ punctuation.separator
//                                          ^^^ variable.parameter
//                                             ^ punctuation.separator
//                                               ^^^ variable.parameter
//                                                  ^ punctuation.separator
                        bv, cv, jv, rv, tv, rav, rbv, errnr) ;
//                      ^^ variable.parameter
//                        ^ punctuation.separator
//                          ^^ variable.parameter
//                            ^ punctuation.separator
//                              ^^ variable.parameter
//                                ^ punctuation.separator
//                                  ^^ variable.parameter
//                                    ^ punctuation.separator
//                                      ^^ variable.parameter
//                                        ^ punctuation.separator
//                                          ^^^ variable.parameter
//                                             ^ punctuation.separator
//                                               ^^^ variable.parameter
//                                                  ^ punctuation.separator
//                                                    ^^^^^ variable.parameter
//                                                         ^ punctuation.section.parens
//                                                           ^ punctuation.terminator.statement
      name bt, ct, jt, rt, tt, rat, rbt ;
//    ^^^^ keyword.other.name
//         ^^ variable
//           ^ punctuation.separator
//             ^^ variable
//               ^ punctuation.separator
//                 ^^ variable
//                   ^ punctuation.separator
//                     ^^ variable
//                       ^ punctuation.separator
//                         ^^ variable
//                           ^ punctuation.separator
//                             ^^^ variable
//                                ^ punctuation.separator
//                                  ^^^ variable
//                                      ^ punctuation.terminator.statement
      BOOLEAN    bt, bv ;
//    ^^^^^^^ storage.type
//               ^^ variable
//                 ^ punctuation.separator
//                   ^^ variable
//                      ^ punctuation.terminator.statement
      CHARACTER  ct, cv ;
//    ^^^^^^^^^ storage.type
//               ^^ variable
//                 ^ punctuation.separator
//                   ^^ variable
//                      ^ punctuation.terminator.statement
      INTEGER    jt, jv ;
//    ^^^^^^^ storage.type
//               ^^ variable
//                 ^ punctuation.separator
//                   ^^ variable
//                      ^ punctuation.terminator.statement
      REAL       rt, rv ;
//    ^^^^ storage.type

//         ^ entity.name.class
//          ^ punctuation.section.parens
//               ^^^ variable
//                  ^ punctuation.separator
//                    ^^^ variable
//                        ^ punctuation.terminator.statement
      REF (B)    rbt, rbv ;
//    ^^^ storage.modifier
//        ^ punctuation.section.parens
//         ^ entity.name.class
//          ^ punctuation.section.parens
//               ^^^ variable
//                  ^ punctuation.separator
//                    ^^^ variable
//                        ^ punctuation.terminator.statement
      integer errnr ;
//    ^^^^^^^ storage.type
//            ^^^^^ variable
//                  ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      if     bt eqv bv
//    ^^ keyword.control.if
//           ^^ variable
//              ^^^ keyword.operator
//                  ^^ variable
         and ct = cv
//       ^^^ keyword.operator
//           ^^ variable
//              ^ keyword.operator.comparison
//                ^^ variable
         and jt = jv
//       ^^^ keyword.operator
//           ^^ variable
//              ^ keyword.operator.comparison
//                ^^ variable
         and rt = rv
//       ^^^ keyword.operator
//           ^^ variable
//              ^ keyword.operator.comparison
//                ^^ variable
         and tt = tv
//       ^^^ keyword.operator
//           ^^ variable
//              ^ keyword.operator.comparison
//                ^^ variable
         and rat.t = rav.t
//       ^^^ keyword.operator
//           ^^^ variable
//              ^ punctuation.accessor
//               ^ variable
//                 ^ keyword.operator.comparison
//                   ^^^ variable
//                      ^ punctuation.accessor
//                       ^ variable
         and rbt.t = rbv.t then
//       ^^^ keyword.operator
//           ^^^ variable
//              ^ punctuation.accessor
//               ^ variable
//                 ^ keyword.operator.comparison
//                   ^^^ variable
//                      ^ punctuation.accessor
//                       ^ variable
//                         ^^^^ keyword.control.then
      else
//    ^^^^ keyword.control.else
      begin
//    ^^^^^ keyword.control.begin
         Outtext ("*** ERROR : Value of variables (") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                  ^ punctuation.section.parens
//                                                    ^ punctuation.terminator.statement
         Outint (errnr, if errnr < 10 then 1 else 2) ;
//       ^^^^^^ entity.name.function
//              ^ punctuation.section.parens
//               ^^^^^ variable
//                    ^ punctuation.separator
//                      ^^ keyword.control.if
//                         ^^^^^ variable
//                               ^ keyword.operator.comparison
//                                 ^^ constant.numeric.decimal
//                                    ^^^^ keyword.control.then
//                                         ^ constant.numeric.decimal
//                                           ^^^^ keyword.control.else
//                                                ^ constant.numeric.decimal
//                                                 ^ punctuation.section.parens
//                                                   ^ punctuation.terminator.statement
         Outtext (").") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^ string.quoted.double
//                    ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
         Outimage ;
//       ^^^^^^^^ variable
//                ^ punctuation.terminator.statement
         Outtext ("            Erroneus values :") ;
//       ^^^^^^^ entity.name.function
//               ^ punctuation.section.parens
//                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
         Outtext (if bt then " true " else " false ") ;

//                   ^^ variable
//                      ^ punctuation.terminator.statement
      TEXT       tt, tv ;
//    ^^^^ storage.type
//               ^^ variable
//                 ^ punctuation.separator
//                   ^^ variable
//                      ^ punctuation.terminator.statement
      REF (A)    rat, rav ;
//    ^^^ storage.modifier

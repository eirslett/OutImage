%  IF b1 EQV b2 THEN myfile.OUTTEXT("OK ") ELSE myfile.OUTTEXT("ERROR");
// <------------------------------------------------------------------------ comment.directive
%  myfile.OUTIMAGE
// <------------------ comment.directive
%  END of procedure Check;
// <-------------------------- comment.directive
   BEGIN
// ^^^^^ keyword.control.begin
   IF b1 EQV b2 THEN OUTTEXT ("OK ") ELSE OUTTEXT ("ERROR");

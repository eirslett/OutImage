// SYNTAX TEST "source.simula" "simtst41"
% ===============================================   Main   program =============
// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 41
// <-------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     Test use of name parameter in external procedure.
// <----------------------------------------------------------------- comment.directive
%
// <- comment.directive
%  EXTERNAL PROCEDURE:  p41 - has to be compiled first.
// <------------------------------------------------------- comment.directive
%
// <- comment.directive
%  WRITTEN BY:  BEH   23/07-86
// <------------------------------ comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   external procedure p41 ;
// ^^^^^^^^ keyword.other.external
//          ^^^^^^^^^ storage.type
//                    ^^^ entity.name.function
//                        ^ punctuation.terminator.statement
   Boolean found_error ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   integer i ;
// ^^^^^^^ storage.type
//         ^ variable
//           ^ punctuation.terminator.statement
   integer array A (0:100) ;
// ^^^^^^^ storage.type
//         ^^^^^ storage.type
//               ^ entity.name.function
//                 ^ punctuation.section.parens
//                  ^ constant.numeric.decimal
//                   ^ punctuation.separator
//                    ^^^ constant.numeric.decimal
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement

   integer procedure teller ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^ storage.type
//                   ^^^^^^ entity.name.function
//                          ^ punctuation.terminator.statement
      teller := i := i+1 ;
//    ^^^^^^ variable
//           ^^ keyword.operator.assignment
//              ^ variable
//                ^^ keyword.operator.assignment
//                   ^ variable
//                    ^ keyword.operator.arithmetic
//                     ^ constant.numeric.decimal
//                       ^ punctuation.terminator.statement

   procedure P (j) ;
// ^^^^^^^^^ storage.type
//           ^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable.parameter
//               ^ punctuation.section.parens
//                 ^ punctuation.terminator.statement
      name j ;
//    ^^^^ keyword.other.name
//         ^ variable
//           ^ punctuation.terminator.statement
      integer j ;
//    ^^^^^^^ storage.type
//            ^ variable
//              ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      while i < 100 do
//    ^^^^^ keyword.control.while
//          ^ variable
//            ^ keyword.operator.comparison
//              ^^^ constant.numeric.decimal
//                  ^^ keyword.control.do
         p41 (A, j) ;
//       ^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ variable
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Outtext ("--- START Simula a.s. TEST 41") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^ punctuation.terminator.statement
   Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
   Outtext ("--- Test use of name paramter in external procedure.") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                                ^ punctuation.section.parens
//                                                                  ^ punctuation.terminator.statement
   Outimage ; Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
//            ^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   p (teller) ;
// ^ entity.name.function
//   ^ punctuation.section.parens
//    ^^^^^^ variable
//          ^ punctuation.section.parens
//            ^ punctuation.terminator.statement

   ! Check that : A (0) = 0, A (1) = 2, A (2) = 0, A (3) = 4, ....;
// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block

   for i := 0, i+1 while not found_error and i <= 100 do
// ^^^ keyword.control.for
//     ^ variable
//       ^^ keyword.operator.assignment
//          ^ constant.numeric.decimal
//           ^ punctuation.separator
//             ^ variable
//              ^ keyword.operator.arithmetic
//               ^ constant.numeric.decimal
//                 ^^^^^ keyword.control.while
//                       ^^^ keyword.operator
//                           ^^^^^^^^^^^ variable
//                                       ^^^ keyword.operator
//                                           ^ variable
//                                             ^^ keyword.operator.comparison
//                                                ^^^ constant.numeric.decimal
//                                                    ^^ keyword.control.do
   if mod (i,2) <> 0 and A (i) <> i+1 or mod (i,2) = 0 and A (i) <> 0 then
// ^^ keyword.control.if
//    ^^^ entity.name.function
//        ^ punctuation.section.parens
//         ^ variable
//          ^ punctuation.separator
//           ^ constant.numeric.decimal
//            ^ punctuation.section.parens
//              ^^ keyword.operator.comparison
//                 ^ constant.numeric.decimal
//                   ^^^ keyword.operator
//                       ^ entity.name.function
//                         ^ punctuation.section.parens
//                          ^ variable
//                           ^ punctuation.section.parens
//                             ^^ keyword.operator.comparison
//                                ^ variable
//                                 ^ keyword.operator.arithmetic
//                                  ^ constant.numeric.decimal
//                                    ^^ keyword.operator
//                                       ^^^ entity.name.function
//                                           ^ punctuation.section.parens
//                                            ^ variable
//                                             ^ punctuation.separator
//                                              ^ constant.numeric.decimal
//                                               ^ punctuation.section.parens
//                                                 ^ keyword.operator.comparison
//                                                   ^ constant.numeric.decimal
//                                                     ^^^ keyword.operator
//                                                         ^ entity.name.function
//                                                           ^ punctuation.section.parens
//                                                            ^ variable
//                                                             ^ punctuation.section.parens
//                                                               ^^ keyword.operator.comparison
//                                                                  ^ constant.numeric.decimal
//                                                                    ^^^^ keyword.control.then
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Values : i = ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                        ^ punctuation.section.parens
//                                          ^ punctuation.terminator.statement
      Outint (i, 4) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outtext ("  A (i) = ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^ string.quoted.double
//                         ^ punctuation.section.parens
//                           ^ punctuation.terminator.statement
      Outint (A (i), 4) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ entity.name.function
//              ^ punctuation.section.parens
//               ^ variable
//                ^ punctuation.section.parens
//                 ^ punctuation.separator
//                   ^ constant.numeric.decimal
//                    ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement




   IF found_error THEN
// ^^ keyword.control.if
//    ^^^^^^^^^^^ variable
//                ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   BEGIN
// ^^^^^ keyword.control.begin
      Outtext ("--- NO ERRORS FOUND IN THIS TEST") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
      Outimage
//    ^^^^^^^^ variable
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 41") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
 END
// <~--- keyword.control.end
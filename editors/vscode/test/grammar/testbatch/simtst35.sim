// <-------------------------------------------------------------------------------- comment.directive
%  PROGRAM NAME:   Simula a.s. - SIMULA TEST NO 35
// <-------------------------------------------------- comment.directive
%
// <- comment.directive
%  PURPOSE:     Test type procedures as parameters.
// <--------------------------------------------------- comment.directive
%
// <- comment.directive
%  NOTE:    1 - Lines after 'NOTE 1' is prefixed with %, because the ND-500
// <--------------------------------------------------------------------------- comment.directive
%               implementation do not manage the parameters. If your imple-
// <--------------------------------------------------------------------------- comment.directive
%               mentation does, the %'s should be removed.
// <---------------------------------------------------------- comment.directive
%
// <- comment.directive
%  WRITTEN BY:  BEH   23/07-86
// <------------------------------ comment.directive
% ==============================================================================
// <-------------------------------------------------------------------------------- comment.directive
BEGIN
// <----- keyword.control.begin
   Boolean found_error ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^^^ variable
//                     ^ punctuation.terminator.statement

   integer i, j ;
// ^^^^^^^ storage.type
//         ^ variable
//          ^ punctuation.separator
//            ^ variable
//              ^ punctuation.terminator.statement
   Boolean b ;
// ^^^^^^^ storage.type
//         ^ variable
//           ^ punctuation.terminator.statement

   Integer Procedure sqri ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^ storage.type
//                   ^^^^ entity.name.function
//                        ^ punctuation.terminator.statement
      sqri := i*i ;
//    ^^^^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//             ^ keyword.operator.arithmetic
//              ^ variable
//                ^ punctuation.terminator.statement

   Integer Procedure P (f) ;
// ^^^^^^^ storage.type
//         ^^^^^^^^^ storage.type
//                   ^ entity.name.function
//                     ^ punctuation.section.parens
//                      ^ variable.parameter
//                       ^ punctuation.section.parens
//                         ^ punctuation.terminator.statement
      name f ;
//    ^^^^ keyword.other.name
//         ^ variable
//           ^ punctuation.terminator.statement
      integer f ;
//    ^^^^^^^ storage.type
//            ^ variable
//              ^ punctuation.terminator.statement
   begin
// ^^^^^ keyword.control.begin
      i := i+1 ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//          ^ keyword.operator.arithmetic
//           ^ constant.numeric.decimal
//             ^ punctuation.terminator.statement
      if i = 10 then
//    ^^ keyword.control.if
//       ^ variable
//         ^ keyword.operator.comparison
//           ^^ constant.numeric.decimal
//              ^^^^ keyword.control.then
         P := f
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
      else
//    ^^^^ keyword.control.else
         P := f + P (f) ;
//       ^ variable
//         ^^ keyword.operator.assignment
//            ^ variable
//              ^ keyword.operator.arithmetic
//                ^ entity.name.function
//                  ^ punctuation.section.parens
//                   ^ variable
//                    ^ punctuation.section.parens
//                      ^ punctuation.terminator.statement
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Procedure Q (f, a) ;
// ^^^^^^^^^ storage.type
//           ^ entity.name.function
//             ^ punctuation.section.parens
//              ^ variable.parameter
//               ^ punctuation.separator
//                 ^ variable.parameter
//                  ^ punctuation.section.parens
//                    ^ punctuation.terminator.statement
      name a ;
//    ^^^^ keyword.other.name
//         ^ variable
//           ^ punctuation.terminator.statement
      integer procedure f ;
//    ^^^^^^^ storage.type
//            ^^^^^^^^^ storage.type
//                      ^ entity.name.function
//                        ^ punctuation.terminator.statement
      integer a ;
//    ^^^^^^^ storage.type
//            ^ variable
//              ^ punctuation.terminator.statement
      a := f ;
//    ^ variable
//      ^^ keyword.operator.assignment
//         ^ variable
//           ^ punctuation.terminator.statement


   Outtext ("--- START Simula a.s. TEST 35") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                         ^ punctuation.section.parens
//                                           ^ punctuation.terminator.statement
   Outimage ;
// ^^^^^^^^ variable
//          ^ punctuation.terminator.statement
   Outtext ("--- Test type procedures as parameters");
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                                  ^ punctuation.section.parens
//                                                   ^ punctuation.terminator.statement
   Outimage; Outimage;
// ^^^^^^^^ variable
//         ^ punctuation.terminator.statement
//           ^^^^^^^^ variable
//                   ^ punctuation.terminator.statement

   i := 2 ;
// ^ variable
//   ^^ keyword.operator.assignment
//      ^ constant.numeric.decimal
//        ^ punctuation.terminator.statement

   Q (sqri, j) ;
// ^ entity.name.function
//   ^ punctuation.section.parens
//    ^^^^ variable
//        ^ punctuation.separator
//          ^ variable
//           ^ punctuation.section.parens
//             ^ punctuation.terminator.statement

   if j <> 4 then
// ^^ keyword.control.if
//    ^ variable
//      ^^ keyword.operator.comparison
//         ^ constant.numeric.decimal
//           ^^^^ keyword.control.then
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Value of j (1).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                          ^ punctuation.section.parens
//                                            ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Erroneus value : ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                            ^ punctuation.section.parens
//                                              ^ punctuation.terminator.statement
      Outint (j, 5) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   i := 0 ;
// ^ variable
//   ^^ keyword.operator.assignment
//      ^ constant.numeric.decimal
//        ^ punctuation.terminator.statement

   j := P (sqri) ;
// ^ variable
//   ^^ keyword.operator.assignment
//      ^ entity.name.function
//        ^ punctuation.section.parens
//         ^^^^ variable
//             ^ punctuation.section.parens
//               ^ punctuation.terminator.statement

   if j <> 385 then
// ^^ keyword.control.if
//    ^ variable
//      ^^ keyword.operator.comparison
//         ^^^ constant.numeric.decimal
//             ^^^^ keyword.control.then
   begin
// ^^^^^ keyword.control.begin
      Outtext ("*** ERROR : Value of j (2).") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                          ^ punctuation.section.parens
//                                            ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      Outtext ("            Erroneus value : ") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                            ^ punctuation.section.parens
//                                              ^ punctuation.terminator.statement
      Outint (j, 7) ;
//    ^^^^^^ entity.name.function
//           ^ punctuation.section.parens
//            ^ variable
//             ^ punctuation.separator
//               ^ constant.numeric.decimal
//                ^ punctuation.section.parens
//                  ^ punctuation.terminator.statement
      Outimage ;
//    ^^^^^^^^ variable
//             ^ punctuation.terminator.statement
      found_error := true
//    ^^^^^^^^^^^ variable
//                ^^ keyword.operator.assignment
//                   ^^^^ constant.language.bool
   end ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement



%  i := 0 ;                                     !********  NOTE 1  ********;
// <---------------------------------------------------------------------------- comment.directive
%
// <- comment.directive
%  Q (P (sqri), j) ;
// <-------------------- comment.directive
%
// <- comment.directive
%  if j <> 385 then
// <------------------- comment.directive
%  begin
// <-------- comment.directive
%     Outtext ("*** ERROR : Value of j (2).") ;
// <----------------------------------------------- comment.directive
%     Outimage ;
// <---------------- comment.directive
%     Outtext ("            Erroneus value : ") ;
// <------------------------------------------------- comment.directive
%     Outint (j, 7) ;
// <--------------------- comment.directive
%     Outimage ;
// <---------------- comment.directive
%     found_error := true
// <------------------------- comment.directive
%  end ;
// <-------- comment.directive



%  i := 0 ;                                     !*******  NOTE 1  ********;
// <--------------------------------------------------------------------------- comment.directive
%
// <- comment.directive
%  Q (P (sqri*i), j) ;
// <---------------------- comment.directive
%
// <- comment.directive
%  if j <> 3025 then
// <-------------------- comment.directive
%  begin
// <-------- comment.directive
%     Outtext ("*** ERROR : Value of j (3).") ;
// <----------------------------------------------- comment.directive
%     Outimage ;
// <---------------- comment.directive
%     Outtext ("            Erroneus value : ") ;
// <------------------------------------------------- comment.directive
%     Outint (j, 7) ;
// <--------------------- comment.directive
%     Outimage ;
// <---------------- comment.directive
%     found_error := true
// <------------------------- comment.directive
%  end ;
// <-------- comment.directive

   IF found_error THEN
// ^^ keyword.control.if
//    ^^^^^^^^^^^ variable
//                ^^^^ keyword.control.then
   ELSE
// ^^^^ keyword.control.else
   BEGIN
// ^^^^^ keyword.control.begin
      Outtext ("--- NO ERRORS FOUND IN THIS TEST") ;
//    ^^^^^^^ entity.name.function
//            ^ punctuation.section.parens
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                               ^ punctuation.section.parens
//                                                 ^ punctuation.terminator.statement
      Outimage
//    ^^^^^^^^ variable
   END ;
// ^^^ keyword.control.end
//     ^ punctuation.terminator.statement

   Outtext ("--- END Simula a.s. TEST 35") ;
// ^^^^^^^ entity.name.function
//         ^ punctuation.section.parens
//          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                                       ^ punctuation.section.parens
//                                         ^ punctuation.terminator.statement
   Outimage
// ^^^^^^^^ variable
 END
// <~--- keyword.control.end
{
  "comments": {
    "lineComment": "--",
    "blockComment": ["!", ";"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*begin\\b",
      "end": "^\\s*end\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_][A-Za-z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(begin|then|do|else)\\b|.*\\bthen\\s*$|.*\\bdo\\s*$",
    "decreaseIndentPattern": "^\\s*end\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*!.*$",
      "action": { "indent": "none", "appendText": "! " }
    },
    {
      "beforeText": "^\\s*--.*$",
      "action": { "indent": "none", "appendText": "-- " }
    },
    {
      "beforeText": "^\\s*begin\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*end\\b",
      "action": { "indent": "outdent" }
    }
  ]
}

! §5.6.13: subclass body may goto a label declared in a prefix class body.;
begin
    integer done;
    class Base;
    begin
        L:
        done := 1;
    end;
    Base class Derived;
    begin
        if done = 0 then goto L;
    end;
    ref(Derived) d;
    d :- new Derived;
    if done = 1 then OutText("ok");
    OutImage;
end

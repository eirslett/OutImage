begin
    real array A(1:4), B(1:3);
    integer i;
    boolean ok;
    for i := 1 step 1 until 4 do A(i) := 0.0;
    B(1) := 1.0;
    B(2) := 2.0;
    B(3) := 3.0;
    histo(A, B, 1.5, 2.0);
    histo(A, B, 2.5, 1.0);
    ok := A(2) = 2.0 and A(3) = 1.0 and A(1) = 0.0 and A(4) = 0.0;
    if ok then OutText("ok") else OutText("fail");
    OutImage;
end
